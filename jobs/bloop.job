//JOB BLOOP    -- Hofstadter's BlooP and FlooP (GEB, chapter XIII)
--
-- Step 1: the Hofstadter sequences, certified by the compiler to halt.
//SALISH FROM=../programs/hofstadter/sequences.sal
//EXEC
//JOB FLOOPASBLOOP   -- ask the compiler to certify the wondrous numbers
//SALISH
bloop
get "../programs/hofstadter/floop"
