	.TITLE	HELLO	A first program for MiniVMS
	.IDENT	/V1.0/
;
; The traditional first program, VMS style: write a line with
; LIB$PUT_OUTPUT, format another with $FAO, read a text file through RMS
; and count its lines.
;
;	$ RUN HELLO
;
	.PSECT	DATA,WRT,NOEXE,LONG
GREETING:	.ASCID	/Hello from user mode on a MicroVAX II./
FORMAT:		.ASCID	/!AS has !UL lines; the time is !%T./
FILENAME:	.ASCID	/DEPARTURE.MSS/
OUTBUF_D:	.LONG	132
		.ADDRESS OUTBUF
OUTLEN:		.WORD	0
		.ALIGN	LONG
LINE_D:		.LONG	0
		.ADDRESS OUTBUF
OUTBUF:		.BLKB	132
RECORD:		.BLKB	256
		.ALIGN	LONG
INFAB:		$FAB	FNM=<DEPARTURE.MSS>,FAC=FAB$M_GET
INRAB:		$RAB	FAB=INFAB,UBF=RECORD,USZ=256

	.PSECT	CODE,NOWRT,EXE,LONG
	.ENTRY	HELLO,^M<R2>
	PUSHAQ	GREETING
	CALLS	#1,G^LIB$PUT_OUTPUT
	$OPEN	FAB=INFAB		; count the lines of a text file
	CHECK
	$CONNECT RAB=INRAB
	CHECK
	CLRL	R2
10$:	$GET	RAB=INRAB
	BLBC	R0,20$
	INCL	R2
	BRB	10$
20$:	$CLOSE	FAB=INFAB
	$FAO_S	CTRSTR=FORMAT,OUTLEN=OUTLEN,OUTBUF=OUTBUF_D,-
		P1=#FILENAME,P2=R2,P3=#0
	MOVW	OUTLEN,LINE_D
	PUSHAQ	LINE_D
	CALLS	#1,G^LIB$PUT_OUTPUT
	MOVL	#SS$_NORMAL,R0
	RET
	.END	HELLO
