	.TITLE	SYSSERV	MiniVMS system services
	.IDENT	/V1.0/
;
; User programs call system services exactly as on VMS:
;
;	CALLS	#n,G^SYS$xxx
;
; SYS$xxx is an entry in the system service vector page, which user mode
; may read and execute.  Each vector holds a register save mask (so the
; service may use R2-R11 freely), a CHMK instruction carrying the service
; number, and a RET.  CHMK traps to kernel mode, where EXE$CHMK dispatches
; on the number with AP still pointing at the caller's argument list.
;
	.PSECT	$$VECTOR
VEC$START::

	.MACRO	VECTOR	NAME,CODE
	.ALIGN	QUAD
NAME::	.WORD	^M<R2,R3,R4,R5,R6,R7,R8,R9,R10,R11>
	CHMK	#CODE
	RET
	.ENDM	VECTOR

	VECTOR	SYS$EXIT,0
	VECTOR	SYS$ASSIGN,1
	VECTOR	SYS$DASSGN,2
	VECTOR	SYS$QIOW,3
	VECTOR	SYS$QIO,3
	VECTOR	SYS$FAO,4
	VECTOR	SYS$FAOL,5
	VECTOR	SYS$GETTIM,6
	VECTOR	SYS$ASCTIM,7
	VECTOR	SYS$EXPREG,8
	VECTOR	SYS$OPEN,9
	VECTOR	SYS$CREATE,10
	VECTOR	SYS$CLOSE,11
	VECTOR	SYS$CONNECT,12
	VECTOR	SYS$DISCONNECT,13
	VECTOR	SYS$GET,14
	VECTOR	SYS$PUT,15
	VECTOR	SYS$READ,16
	VECTOR	SYS$WRITE,17
	VECTOR	SYS$REWIND,18
	VECTOR	SYS$ERASE,19
	VECTOR	LIB$PUT_OUTPUT,20
	VECTOR	LIB$GET_INPUT,21
	VECTOR	LIB$INIT_TIMER,22
	VECTOR	LIB$SHOW_TIMER,23
	VECTOR	SYS$WAITFR,24
	VECTOR	SYS$SETEF,24
	VECTOR	SYS$CLREF,24

;
; Image start-up and CTRL/Y stubs, executed in user mode.
;
	.ALIGN	QUAD
IMG$START::
	CALLS	#0,@IMG$TRANSFER	; call the program's entry point
	PUSHL	R0			; and exit with its status
	CALLS	#1,SYS$EXIT
IMG$CTRLY::
	PUSHL	#SS$_CONTROLY		; the clock interrupt sends a
	CALLS	#1,SYS$EXIT		; CTRL/Y-ed program here
	.ALIGN	LONG
IMG$TRANSFER::	.LONG	0
VEC$END::

	.PSECT	$DATA
	.ALIGN	LONG
SVC$TABLE:
	.ADDRESS SVC$EXIT, SVC$ASSIGN, SVC$DASSGN, SVC$QIOW
	.ADDRESS SVC$FAO, SVC$FAOL, SVC$GETTIM, SVC$ASCTIM
	.ADDRESS SVC$EXPREG, RMS$OPEN, RMS$CREATE, RMS$CLOSE
	.ADDRESS RMS$CONNECT, RMS$DISCONNECT, RMS$GET, RMS$PUT
	.ADDRESS RMS$READ, RMS$WRITE, RMS$REWIND, RMS$ERASE
	.ADDRESS LIB$$PUT_OUTPUT, LIB$$GET_INPUT, LIB$$INIT_TIMER
	.ADDRESS LIB$$SHOW_TIMER, SVC$NOP
SVC$K_COUNT = <.-SVC$TABLE>/4

EXE$GL_INSERVICE::	.LONG	0
EXE$GL_BUFIO::		.LONG	0
EXE$GL_FAULTS::		.LONG	0
LIB$GL_T0:		.LONG	0	; LIB$INIT_TIMER snapshot
LIB$GL_C0:		.LONG	0
LIB$GL_B0:		.LONG	0
LIB$GL_D0:		.LONG	0
SVC$BUFFER:		.BLKB	512

	.PSECT	$CODE
;
; CHMK dispatcher.  Kernel stack: (SP) = service number, then PC, PSL.
;
	.ALIGN	LONG
EXE$CHMK::
	MOVL	(SP)+,R0
	CMPL	R0,#SVC$K_COUNT
	BLSSU	10$
	MOVL	#SS$_ILLSER,R0
	REI
10$:	MOVL	#1,EXE$GL_INSERVICE
	MOVL	SVC$TABLE[R0],R1
	JSB	(R1)
	CLRL	EXE$GL_INSERVICE
	TSTL	CON$GL_ABORT		; CTRL/Y typed during the service?
	BNEQ	20$
	REI
20$:	MOVL	#SS$_CONTROLY,R0
	BRW	SVC$EXIT1

SVC$NOP:
	MOVL	#SS$_NORMAL,R0
	RSB

;
; $EXIT [code]
;
SVC$EXIT:
	MOVL	#SS$_NORMAL,R0
	TSTL	(AP)
	BEQL	SVC$EXIT1
	MOVL	4(AP),R0
SVC$EXIT1:
	JMP	EXE$IMGEXIT

;
; $ASSIGN devnam, chan -- every terminal name gives channel 1.
;
SVC$ASSIGN:
	MOVW	#1,@8(AP)
	MOVL	#SS$_NORMAL,R0
	RSB

SVC$DASSGN:
	MOVL	#SS$_NORMAL,R0
	RSB

;
; $QIOW efn,chan,func,iosb,astadr,astprm,p1,p2,p3,p4,p5,p6
; Terminal I/O only: write virtual/logical/physical block, read, read
; with prompt.
;
SVC$QIOW:
	CMPZV	#0,#16,8(AP),#1
	BEQL	10$
	MOVL	#SS$_IVCHAN,R0
	RSB
10$:	INCL	EXE$GL_BUFIO
	BICL3	#^C^X3F,12(AP),R2	; function code
	MOVL	28(AP),R7		; P1 buffer
	MOVL	32(AP),R8		; P2 length
	CMPL	R2,#^X30		; IO$_WRITEVBLK
	BEQL	20$
	CMPL	R2,#^X20		; IO$_WRITELBLK
	BEQL	20$
	CMPL	R2,#^X0B		; IO$_WRITEPBLK
	BEQL	20$
	CMPL	R2,#^X31		; IO$_READVBLK
	BEQL	40$
	CMPL	R2,#^X21		; IO$_READLBLK
	BEQL	40$
	CMPL	R2,#^X0C		; IO$_READPBLK
	BEQL	40$
	CMPL	R2,#^X37		; IO$_READPROMPT
	BEQL	30$
	MOVL	#SS$_NORMAL,R0		; anything else: no-op
	CLRL	R1
	BRB	80$
20$:	MOVL	R8,R0			; write
	MOVL	R7,R1
	JSB	CON$PUTS
	MOVL	R8,R1
	MOVL	#SS$_NORMAL,R0
	CLRL	R2
	BRB	80$
30$:	MOVL	48(AP),R0		; prompt (P5 address, P6 length)
	MOVL	44(AP),R1
	JSB	CON$PUTS
40$:	MOVL	R7,R1			; read a line
	MOVL	R8,R2
	EXTZV	#6,#1,12(AP),R3		; IO$M_NOECHO
	JSB	CON$GETLINE
	TSTL	R0
	BGEQ	50$
	CLRL	R1
	MOVL	#SS$_ENDOFFILE,R0
	MOVL	#CTRLZ,R2
	BRB	80$
50$:	MOVL	R1,R2			; terminator
	MOVL	R0,R1			; count
	MOVL	#SS$_NORMAL,R0
80$:	MOVL	16(AP),R3		; IOSB
	BEQL	90$
	MOVW	R0,(R3)
	MOVW	R1,2(R3)
	MOVW	R2,4(R3)
	MOVW	#1,6(R3)
90$:	MOVL	#SS$_NORMAL,R0
	RSB

;
; $FAO ctrstr,outlen,outbuf,p1...   $FAOL ctrstr,outlen,outbuf,prmlst
;
SVC$FAO:
	MOVAL	16(AP),R1
	BRB	SVC$FAO1
SVC$FAOL:
	MOVL	16(AP),R1
SVC$FAO1:
	MOVL	4(AP),R0
	MOVL	12(AP),R4
	MOVZWL	DSC$W_LENGTH(R4),R3
	MOVL	DSC$A_POINTER(R4),R2
	JSB	EXE$FAO
	MOVL	8(AP),R2
	BEQL	10$
	MOVW	R1,(R2)
10$:	RSB

;
; $GETTIM timadr
;
SVC$GETTIM:
	JSB	TIM$NOW
	JSB	TIM$TOQUAD
	MOVQ	R0,@4(AP)
	MOVL	#SS$_NORMAL,R0
	RSB

;
; $ASCTIM timlen,timbuf,timadr,cvtflg
;
SVC$ASCTIM:
	MOVAB	SVC$ASCTIM_D,R0
	BLBC	16(AP),10$
	MOVAB	SVC$ASCTIM_T,R0
10$:	MOVAL	12(AP),R1		; parameter: the timadr argument
	MOVL	8(AP),R4
	MOVZWL	DSC$W_LENGTH(R4),R3
	MOVL	DSC$A_POINTER(R4),R2
	JSB	EXE$FAO
	MOVL	4(AP),R2
	BEQL	20$
	MOVW	R1,(R2)
20$:	RSB

;
; $EXPREG pagcnt,retadr,acmode,region -- add pages to the end of P0.
;
SVC$EXPREG:
	MFPR	#PR$_P0LR,R6		; first new page
	ADDL3	4(AP),R6,R7		; new length
	CMPL	R7,#USR$K_MAXPAGES
	BLEQ	10$
	MOVL	#SS$_INSFMEM,R0
	RSB
10$:	MOVL	R6,R8
20$:	CMPL	R8,R7
	BGEQ	30$
	ADDL3	#USR$K_PFN0,R8,R0
	BISL3	#PTE$K_UW,R0,MMG$P0PT[R8]
	ASHL	#9,R0,R1		; clear the page through its S0 alias
	ADDL2	#S0$K_BASE,R1
	PUSHR	#^M<R6,R7,R8>
	MOVC5	#0,(SP),#0,#512,(R1)
	POPR	#^M<R6,R7,R8>
	INCL	R8
	INCL	EXE$GL_FAULTS
	BRB	20$
30$:	MTPR	R7,#PR$_P0LR
	MTPR	#0,#PR$_TBIA
	MOVL	8(AP),R2
	BEQL	40$
	ASHL	#9,R6,(R2)
	ASHL	#9,R7,R0
	DECL	R0
	MOVL	R0,4(R2)
40$:	MOVL	#SS$_NORMAL,R0
	RSB

;
; LIB$PUT_OUTPUT string
;
LIB$$PUT_OUTPUT:
	INCL	EXE$GL_BUFIO
	MOVL	4(AP),R2
	MOVZWL	DSC$W_LENGTH(R2),R0
	MOVL	DSC$A_POINTER(R2),R1
	JSB	CON$PUTS
	JSB	CON$CRLF
	MOVL	#SS$_NORMAL,R0
	RSB

;
; LIB$GET_INPUT get-str [,prompt-str [,out-len]]
;
LIB$$GET_INPUT:
	INCL	EXE$GL_BUFIO
	CMPL	(AP),#2
	BLSS	10$
	MOVL	8(AP),R2
	BEQL	10$
	MOVZWL	DSC$W_LENGTH(R2),R0
	MOVL	DSC$A_POINTER(R2),R1
	JSB	CON$PUTS
10$:	MOVL	4(AP),R4
	MOVL	DSC$A_POINTER(R4),R1
	MOVZWL	DSC$W_LENGTH(R4),R2
	CLRL	R3
	JSB	CON$GETLINE
	TSTL	R0
	BGEQ	20$
	CLRL	R0
	MOVL	#RMS$_EOF,R5
	BRB	30$
20$:	MOVL	#SS$_NORMAL,R5
30$:	CMPL	(AP),#3
	BLSS	40$
	MOVL	12(AP),R2
	BEQL	40$
	MOVW	R0,(R2)
40$:	MOVL	R5,R0
	RSB

;
; LIB$INIT_TIMER / LIB$SHOW_TIMER
;
LIB$$INIT_TIMER:
	MOVL	EXE$GL_TICKS,LIB$GL_T0
	MOVL	EXE$GL_CPUTICKS,LIB$GL_C0
	MOVL	EXE$GL_BUFIO,LIB$GL_B0
	MOVL	DU$GL_DIRIO,LIB$GL_D0
	MOVL	#SS$_NORMAL,R0
	RSB

LIB$$SHOW_TIMER:
	SUBL3	LIB$GL_T0,EXE$GL_TICKS,R6	; elapsed centiseconds
	CLRL	R7
	EDIV	#8640000,R6,R8,R6	; R8 days, R6 centiseconds
	MOVL	R6,R1
	JSB	TIM$TIMESTR
	MOVC3	#11,FAO$NUMBUF,LIB$ELAPSED
	SUBL3	LIB$GL_C0,EXE$GL_CPUTICKS,R1
	JSB	TIM$TIMESTR
	MOVC3	#10,FAO$NUMBUF+1,LIB$CPU
	SUBL3	LIB$GL_B0,EXE$GL_BUFIO,R9
	SUBL3	LIB$GL_D0,DU$GL_DIRIO,R10
	PUSHL	EXE$GL_FAULTS
	PUSHL	R10
	PUSHL	R9
	PUSHAB	LIB$CPU
	PUSHL	#10
	PUSHAB	LIB$ELAPSED
	PUSHL	#11
	PUSHL	R8
	PUSHAB	LIB$M_TIMER
	CALLS	#9,EXE$PRINT
	MOVL	#SS$_NORMAL,R0
	RSB

	.PSECT	$DATA
SVC$ASCTIM_D:	.ASCID	/!%D/
SVC$ASCTIM_T:	.ASCID	/!%T/
LIB$ELAPSED:	.BLKB	11
LIB$CPU:	.BLKB	10
LIB$M_TIMER:	.ASCID	/ ELAPSED: !4UL !AD  CPU: !AD  BUFIO: !UL  DIRIO: !UL  FAULTS: !UL/
