-- =====================================================================
--  The TRI-TRAN run-time library
--
--  Compiled by SALISH/O and loaded with every TRI-TRAN program; the
--  compiler calls these procedures with SALISH's calling convention,
--  passing values (not addresses).
--
--    FORMAT      tt_wbeg tt_wi tt_wr tt_wl tt_wa tt_wend   (output)
--                tt_rbeg tt_ri tt_rr tt_rl tt_ra           (input)
--    functions   SQRT EXP ALOG ALOG10 SIN COS TANH ATAN ATAN2
--    arithmetic  INT/IFIX (truncation), AINT, AMOD, SIGN, ISIGN, DIM,
--                IDIM, I**J, X**I, X**Y
--    control     STOP n, PAUSE n
--
--  REAL is the floating-point unit's word: a 5-trit exponent and a
--  22-trit mantissa, value m * 3^(e-21).  Some of the functions work on
--  the fields directly, as a ternary machine invites: EXP multiplies by
--  3^k by adding k to the exponent, ALOG takes the exponent off and
--  multiplies it by ln 3, and SQRT starts from 3^(e/2).
-- =====================================================================

-- floating-point constants, as words (see duwamish/fpu.py)
const ONE = 10460353203, TWO = 38354628411, HALF = 5230176602
const LN3 = 11491872573, LN3HI = 11491880184, LN3LO = -420088765744
const INVLN3 = 9521423810
const PI = 42335115868, PI2 = 36858087738
const PI2HI = 36858090555, PI2LO = -421425406274
const TWOBYPI = 6659267675, LOG10E = -17752438585
const P22 = 31381059609, P21 = 10460353203
const FMAX = 3812798742493                  -- 121 * 3^22 + (3^22 - 1)/2

-- FORMAT codes: the compiler's encoding (duwamish/tritran.py)
const F_END = 0, F_I = 1, F_F = 2, F_E = 3, F_X = 4, F_H = 5, F_SLASH = 6
const F_L = 7, F_B = 8, F_GROUP = 9, F_ENDGROUP = 10

global ipow10 := table(1, 10, 100, 1000, 10000, 100000, 1000000, 10000000,
                       100000000, 1000000000, 10000000000, 100000000000,
                       1000000000000)
global pow10f[11]

proc tt_init()
begin
  for k := 0 to 10 do pow10f[k] := float(ipow10[k])
end

-- ---------------------------------------------------------------------
--  errors and the operator's console
-- ---------------------------------------------------------------------
proc tt_ttynum(n)
begin
  var buf[14], k := 0, m := n
  if m < 0 then begin ttyc('-'); m := -m end
  repeat
    buf[k] := m mod 10
    m := m / 10
    k := k + 1
  until m = 0
  for i := k - 1 to 0 by -1 do ttyc('0' + buf[i])
end

proc tt_fail(s)
begin
  prints("\n *** TRI-TRAN RUN-TIME ERROR: ")
  prints(s)
  newline()
  exit(9)
end

-- STOP n: the number appears on the console typewriter
proc tt_stop(n)
begin
  ttyc('S'); ttyc('T'); ttyc('O'); ttyc('P'); ttyc(' ')
  tt_ttynum(n)
  ttyc('\n')
  exit(n)
end

-- PAUSE n: the operator reads it, and presses START
proc tt_pause(n)
begin
  ttyc('P'); ttyc('A'); ttyc('U'); ttyc('S'); ttyc('E')
  if n >= 0 then begin ttyc(' '); tt_ttynum(n) end
  ttyc('\n')
end

-- ---------------------------------------------------------------------
--  arithmetic
-- ---------------------------------------------------------------------
proc tt_fneg(x) = fsub(0, x)
proc tt_fabs(x) = fcmp(x, 0) < 0 -> fsub(0, x), x

-- REAL to INTEGER truncates toward zero; the FIX instruction rounds
proc tt_ifix(x)
begin
  var n := fix(x)
  if fcmp(x, 0) >= 0 then begin
    if fcmp(float(n), x) > 0 then n := n - 1
  end else if fcmp(float(n), x) < 0 then n := n + 1
  return n
end

proc tt_aint(x) = float(tt_ifix(x))
proc tt_amod(a, b) = fsub(a, fmul(tt_aint(fdiv(a, b)), b))
proc tt_sign(a, b) = fcmp(b, 0) >= 0 -> tt_fabs(a), tt_fneg(tt_fabs(a))
proc tt_isign(a, b) = b >= 0 -> abs(a), -abs(a)
proc tt_dim(a, b) = fcmp(a, b) > 0 -> fsub(a, b), 0
proc tt_idim(a, b) = a > b -> a - b, 0

-- I**J.  A negative power of an integer is 0, unless the integer is 1 or
-- -1.  Otherwise by the ternary digits of J, most significant first:
-- cube, then multiply by I or I*I as the digit is 1 or 2.
proc tt_ipow(i, n)
begin
  var d[27], k := 0, m := n, r := 1
  if n < 0 then begin
    if i = 0 then tt_fail("ZERO TO A NEGATIVE POWER")
    if i = 1 then return 1
    if i = -1 then return (n mod 2 = 0) -> 1, -1
    return 0
  end
  while m > 0 do begin d[k] := m mod 3; m := m / 3; k := k + 1 end
  for j := k - 1 to 0 by -1 do begin
    r := r * r * r
    if d[j] = 1 then r := r * i
    else if d[j] = 2 then r := r * i * i
  end
  return r
end

-- X**I by the balanced-ternary digits of I, most significant first: cube,
-- then multiply by X for the trit 1, or by 1/X for the trit T.  (The
-- binary method of Knuth, Vol. 2, 4.6.3, squares and multiplies by X; on
-- a balanced machine a negative power costs one division, not a
-- reciprocal at the end.)
proc tt_rpowi(x, n)
begin
  var r := ONE, top := -1, inv := 0, tr
  if n = 0 then return ONE
  if x = 0 then begin
    if n < 0 then tt_fail("ZERO TO A NEGATIVE POWER")
    return 0
  end
  for i := 0 to 26 do if xtr(n, i, 1) <> 0 then top := i
  for i := top to 0 by -1 do begin
    r := fmul(fmul(r, r), r)
    tr := xtr(n, i, 1)
    if tr > 0 then r := fmul(r, x)
    else if tr < 0 then begin
      if inv = 0 then inv := fdiv(ONE, x)
      r := fmul(r, inv)
    end
  end
  return r
end

-- ---------------------------------------------------------------------
--  the mathematical functions
-- ---------------------------------------------------------------------
proc tt_sqrt(x)
begin
  var e, g
  if fcmp(x, 0) < 0 then tt_fail("SQRT OF A NEGATIVE NUMBER")
  if x = 0 then return 0
  -- x is m 3^(e-21), within a factor 1.5 of 3^e: start from 3^(e/2)
  e := xtr(x, 22, 5)
  g := (e / 2) * P22 + P21
  for i := 1 to 7 do g := fmul(HALF, fadd(g, fdiv(x, g)))
  return g
end

-- e^x = 3^k e^r, with k the nearest integer to x / ln 3.  r is found in
-- two parts (Cody and Waite): k ln3hi is exact, since ln3hi has 11 trits.
-- 3^k costs nothing: it is added to the exponent.
proc tt_exp(x)
begin
  var k, r, p, e
  if fcmp(x, float(134)) > 0 then return FMAX
  if fcmp(x, float(-134)) < 0 then return 0
  k := fix(fmul(x, INVLN3))
  r := fsub(fsub(x, fmul(float(k), LN3HI)), fmul(float(k), LN3LO))
  p := ONE
  for n := 13 to 1 by -1 do p := fadd(ONE, fdiv(fmul(r, p), float(n)))
  e := xtr(p, 22, 5) + k
  if e > 121 then return FMAX
  if e < -121 then return 0
  return p + k * P22
end

-- ln x = e ln 3 + ln f, where f is x with its exponent field set to 0,
-- between 1/2 and 3/2; ln f = 2 atanh s, s = (f-1)/(f+1), |s| <= 1/3.
proc tt_alog(x)
begin
  var e, f, s, s2, p
  if fcmp(x, 0) <= 0 then tt_fail("ALOG OF A NUMBER NOT POSITIVE")
  e := xtr(x, 22, 5)
  f := x - e * P22
  s := fdiv(fsub(f, ONE), fadd(f, ONE))
  s2 := fmul(s, s)
  p := fdiv(ONE, float(25))
  for n := 11 to 0 by -1 do p := fadd(fdiv(ONE, float(2 * n + 1)), fmul(s2, p))
  p := fmul(TWO, fmul(s, p))
  return fadd(fmul(float(e), LN3HI), fadd(fmul(float(e), LN3LO), p))
end

proc tt_alog10(x) = fmul(tt_alog(x), LOG10E)

-- sine and cosine: x = k pi/2 + r, |r| <= pi/4, then the Taylor series
global tt_quad
proc tt_reduce(x)
begin
  var k := fix(fmul(x, TWOBYPI))
  tt_quad := k mod 4
  if tt_quad < 0 then tt_quad := tt_quad + 4
  return fsub(fsub(x, fmul(float(k), PI2HI)), fmul(float(k), PI2LO))
end

proc tt_sinr(r)
begin
  var r2 := fmul(r, r), p := ONE
  for j := 8 to 1 by -1 do
    p := fsub(ONE, fdiv(fmul(r2, p), float(2 * j * (2 * j + 1))))
  return fmul(r, p)
end

proc tt_cosr(r)
begin
  var r2 := fmul(r, r), p := ONE
  for j := 8 to 1 by -1 do
    p := fsub(ONE, fdiv(fmul(r2, p), float((2 * j - 1) * 2 * j)))
  return p
end

proc tt_sin(x)
begin
  var r := tt_reduce(x)
  if tt_quad = 0 then return tt_sinr(r)
  if tt_quad = 1 then return tt_cosr(r)
  if tt_quad = 2 then return tt_fneg(tt_sinr(r))
  return tt_fneg(tt_cosr(r))
end

proc tt_cos(x)
begin
  var r := tt_reduce(x)
  if tt_quad = 0 then return tt_cosr(r)
  if tt_quad = 1 then return tt_fneg(tt_sinr(r))
  if tt_quad = 2 then return tt_fneg(tt_cosr(r))
  return tt_sinr(r)
end

-- atan: for |x| > 1, pi/2 - atan(1/x); then halve the angle twice,
-- t -> t / (1 + sqrt(1 + t^2)), to |t| < 0.2, and sum the series
proc tt_atan(x)
begin
  var neg := fcmp(x, 0) < 0, ax := tt_fabs(x), inv := false, y2, p, a
  if fcmp(ax, ONE) > 0 then begin ax := fdiv(ONE, ax); inv := true end
  for i := 1 to 2 do
    ax := fdiv(ax, fadd(ONE, tt_sqrt(fadd(ONE, fmul(ax, ax)))))
  y2 := fmul(ax, ax)
  p := fdiv(ONE, float(19))
  for n := 8 to 0 by -1 do p := fsub(fdiv(ONE, float(2 * n + 1)), fmul(y2, p))
  a := fmul(float(4), fmul(ax, p))
  if inv then a := fsub(PI2, a)
  if neg then a := tt_fneg(a)
  return a
end

proc tt_atan2(y, x)
begin
  var c := fcmp(x, 0)
  if c > 0 then return tt_atan(fdiv(y, x))
  if c < 0 then begin
    if fcmp(y, 0) >= 0 then return fadd(tt_atan(fdiv(y, x)), PI)
    return fsub(tt_atan(fdiv(y, x)), PI)
  end
  c := fcmp(y, 0)
  if c = 0 then tt_fail("ATAN2(0, 0)")
  return c > 0 -> PI2, tt_fneg(PI2)
end

proc tt_tanh(x)
begin
  var ax := tt_fabs(x), x2, p, t, a
  if fcmp(ax, float(30)) > 0 then return fcmp(x, 0) > 0 -> ONE, tt_fneg(ONE)
  if fcmp(ax, fdiv(ONE, float(10))) < 0 then begin
    -- tanh x = x - x^3/3 + 2x^5/15 - 17x^7/315 + 62x^9/2835 - 1382x^11/155925
    x2 := fmul(x, x)
    p := fdiv(float(-1382), float(155925))
    p := fadd(fdiv(float(62), float(2835)), fmul(x2, p))
    p := fadd(fdiv(float(-17), float(315)), fmul(x2, p))
    p := fadd(fdiv(float(2), float(15)), fmul(x2, p))
    p := fadd(fdiv(float(-1), float(3)), fmul(x2, p))
    p := fadd(ONE, fmul(x2, p))
    return fmul(x, p)
  end
  t := tt_exp(fmul(float(-2), ax))
  a := fdiv(fsub(ONE, t), fadd(ONE, t))
  return fcmp(x, 0) < 0 -> tt_fneg(a), a
end

proc tt_rpow(x, y)
begin
  var c := fcmp(x, 0)
  if c = 0 then begin
    if fcmp(y, 0) <= 0 then tt_fail("ZERO TO A POWER NOT POSITIVE")
    return 0
  end
  if c < 0 then tt_fail("A NEGATIVE NUMBER TO A REAL POWER")
  return tt_exp(fmul(y, tt_alog(x)))
end

-- x times 10^n
proc tt_scale10(x, n)
begin
  var r := x, m := n
  while m > 10 do begin r := fmul(r, pow10f[10]); m := m - 10 end
  while m < -10 do begin r := fdiv(r, pow10f[10]); m := m + 10 end
  if m > 0 then r := fmul(r, pow10f[m])
  else if m < 0 then r := fdiv(r, pow10f[-m])
  return r
end

-- ---------------------------------------------------------------------
--  FORMAT
--
--  The compiler turns each FORMAT statement into a table of codes; the
--  table's first word says where to start again when the list outlasts
--  the format ("reversion": at the last top-level group, or at the
--  beginning).  Output builds a line; on the printer its first character
--  is carriage control: blank for the next line, 0 to skip a line, 1 for
--  a new page (a blank line, on this continuous paper), + to overprint
--  (which this printer cannot: it starts a new line).
-- ---------------------------------------------------------------------
global ff, fpos, funit, ndata
global gstart[4], gcount[4], gdepth
global fline[140], fcol, flen
global card[81], cardlen

proc ff_putch(c)
begin
  if fcol < 136 then begin
    fline[fcol] := c
    fcol := fcol + 1
    if fcol > flen then flen := fcol
  end
end

proc ff_record_out()
begin
  var cc
  if funit = 7 then begin
    for i := 0 to flen - 1 do punch(fline[i])
    punch('\n')
  end else begin
    cc := flen > 0 -> fline[0], ' '
    if cc = '0' or cc = '1' then putc('\n')
    for i := 1 to flen - 1 do putc(fline[i])
    putc('\n')
  end
  for i := 0 to 139 do fline[i] := ' '
  fcol := 0
  flen := 0
end

-- read the next card; false at the end of the deck
proc ff_read_card()
begin
  var c := getc()
  cardlen := 0
  fcol := 0
  if c < 0 then return false
  while c >= 0 and c <> '\n' do begin
    if cardlen < 80 then begin card[cardlen] := c; cardlen := cardlen + 1 end
    c := getc()
  end
  return true
end

proc ff_getch()
begin
  var c := fcol < cardlen -> card[fcol], ' '
  fcol := fcol + 1
  return c
end

proc ff_record()
begin
  if funit = 5 then begin
    if not ff_read_card() then tt_fail("END OF DATA ON THE CARD READER")
  end else ff_record_out()
end

-- obey one code that is not a data descriptor
proc ff_edit(c)
begin
  var n
  if c = F_X then begin
    fcol := fcol + ff[fpos + 1]
    fpos := fpos + 2
  end else if c = F_H then begin
    n := ff[fpos + 1]
    if funit = 5 then fcol := fcol + n
    else for i := 1 to n do ff_putch(ff[fpos + 1 + i])
    fpos := fpos + 2 + n
  end else if c = F_SLASH then begin
    ff_record()
    fpos := fpos + 1
  end else if c = F_GROUP then begin
    gdepth := gdepth + 1
    if gdepth > 3 then tt_fail("FORMAT GROUPS NESTED TOO DEEPLY")
    gcount[gdepth] := ff[fpos + 1]
    fpos := fpos + 2
    gstart[gdepth] := fpos
  end else if c = F_ENDGROUP then begin
    gcount[gdepth] := gcount[gdepth] - 1
    if gcount[gdepth] > 0 then fpos := gstart[gdepth]
    else begin gdepth := gdepth - 1; fpos := fpos + 1 end
  end else tt_fail("BAD FORMAT CODE")
end

proc ff_is_data(c) = c = F_I or c = F_F or c = F_E or c = F_L or c = F_B

-- move to the next data descriptor, obeying everything before it
proc ff_next()
begin
  var c, p
  repeat
    c := ff[fpos]
    if ff_is_data(c) then begin
      p := fpos
      fpos := fpos + (c = F_F or c = F_E -> 3, 2)
      ndata := ndata + 1
      return p
    end
    if c = F_END then begin
      if ndata = 0 then tt_fail("FORMAT HAS NO FIELD FOR THE LIST")
      ff_record()
      fpos := ff[0]
      gdepth := 0
      ndata := 0
    end else ff_edit(c)
  until false
end

proc ff_begin(f, u)
begin
  ff := f
  fpos := 1
  funit := u
  ndata := 0
  gdepth := 0
  fcol := 0
end

-- ---------------- output fields ----------------
proc ff_stars(w)
begin
  for i := 1 to w do ff_putch('*')
end

proc ff_ndigits(n)
begin
  var k := 1
  for i := 1 to 12 do if n >= ipow10[i] then k := k + 1
  return k
end

-- n (>= 0) as exactly k digits
proc ff_digits(n, k)
begin
  for i := k - 1 to 0 by -1 do ff_putch('0' + (n / ipow10[i]) mod 10)
end

proc ff_put_int(v, w)
begin
  var m := abs(v), k, len
  k := ff_ndigits(m)
  len := k + (v < 0 -> 1, 0)
  if len > w then return ff_stars(w)
  for i := 1 to w - len do ff_putch(' ')
  if v < 0 then ff_putch('-')
  ff_digits(m, k)
end

-- Bw: balanced ternary, with T for the trit -1
proc ff_put_tern(v, w)
begin
  var top := 0
  for i := 0 to 26 do if xtr(v, i, 1) <> 0 then top := i
  if top + 1 > w then return ff_stars(w)
  for i := 1 to w - top - 1 do ff_putch(' ')
  for i := top to 0 by -1 do ff_putch(tritchar(xtr(v, i, 1)))
end

-- Lw: T, F or U
proc ff_put_log(v, w)
begin
  for i := 1 to w - 1 do ff_putch(' ')
  ff_putch(v > 0 -> 'T', v < 0 -> 'F', 'U')
end

-- Fw.d
proc ff_put_f(x, w, d)
begin
  var neg := fcmp(x, 0) < 0, ax := tt_fabs(x), sc, n, ip, fr, len, drop := false
  if d > 11 then return ff_stars(w)
  sc := tt_scale10(ax, d)
  if fcmp(sc, float(ipow10[12])) >= 0 then return ff_stars(w)
  n := fix(sc)
  ip := n / ipow10[d]
  fr := n mod ipow10[d]
  if n = 0 then neg := false
  len := (neg -> 1, 0) + ff_ndigits(ip) + 1 + d
  if len > w and ip = 0 then begin drop := true; len := len - 1 end
  if len > w then return ff_stars(w)
  for i := 1 to w - len do ff_putch(' ')
  if neg then ff_putch('-')
  if not drop then ff_digits(ip, ff_ndigits(ip))
  ff_putch('.')
  ff_digits(fr, d)
end

-- Ew.d: 0.dddd E+kk
proc ff_put_e(x, w, d)
begin
  var neg := fcmp(x, 0) < 0, ax := tt_fabs(x), k := 0, n := 0, len
  var ak, drop := false, lo, hi
  if d > 11 or d < 1 then return ff_stars(w)
  hi := ipow10[d]
  lo := ipow10[d - 1]
  if x <> 0 then begin
    -- ax is within a factor 1.5 of 3^e, and log10 3 = 0.4771
    k := xtr(ax, 22, 5) * 4771 / 10000 + 1
    for i := 1 to 8 do begin
      n := fix(tt_scale10(ax, d - k))
      if n >= hi then k := k + 1
      else if n < lo then k := k - 1
    end
    n := fix(tt_scale10(ax, d - k))
    if n >= hi then begin k := k + 1; n := fix(tt_scale10(ax, d - k)) end
  end
  ak := abs(k)
  len := (neg -> 1, 0) + 2 + d + 4
  if len > w then begin drop := true; len := len - 1 end
  if len > w then return ff_stars(w)
  for i := 1 to w - len do ff_putch(' ')
  if neg then ff_putch('-')
  if not drop then ff_putch('0')
  ff_putch('.')
  ff_digits(n, d)
  if ak >= 100 then begin
    ff_putch(k < 0 -> '-', '+')
    ff_digits(ak, 3)
  end else begin
    ff_putch('E')
    ff_putch(k < 0 -> '-', '+')
    ff_digits(ak, 2)
  end
end

proc ff_mismatch(what)
begin
  prints("\n *** TRI-TRAN RUN-TIME ERROR: FORMAT MISMATCH: ")
  prints(what)
  newline()
  exit(9)
end

proc tt_wbeg(f, u)
begin
  ff_begin(f, u)
  for i := 0 to 139 do fline[i] := ' '
  flen := 0
end

proc tt_wi(v)
begin
  var p := ff_next(), c := ff[p]
  if c = F_I then ff_put_int(v, ff[p + 1])
  else if c = F_B then ff_put_tern(v, ff[p + 1])
  else ff_mismatch("AN INTEGER NEEDS AN I OR B FIELD")
end

proc tt_wr(x)
begin
  var p := ff_next(), c := ff[p]
  if c = F_F then ff_put_f(x, ff[p + 1], ff[p + 2])
  else if c = F_E then ff_put_e(x, ff[p + 1], ff[p + 2])
  else ff_mismatch("A REAL NEEDS AN F OR E FIELD")
end

proc tt_wl(v)
begin
  var p := ff_next(), c := ff[p]
  if c = F_L then ff_put_log(v, ff[p + 1])
  else ff_mismatch("A LOGICAL NEEDS AN L FIELD")
end

-- a whole array: ty is -1 INTEGER, 0 REAL, +1 LOGICAL
proc tt_wa(a, n, ty)
begin
  for i := 0 to n - 1 do begin
    if ty < 0 then tt_wi(a[i])
    else if ty = 0 then tt_wr(a[i])
    else tt_wl(a[i])
  end
end

-- the end of the list: obey the format up to its next data descriptor,
-- or its end, and finish the record
proc tt_wend()
begin
  var c := ff[fpos]
  while not ff_is_data(c) and c <> F_END do begin
    ff_edit(c)
    c := ff[fpos]
  end
  ff_record_out()
end

-- ---------------- input fields ----------------
--  As in FORTRAN 66, a blank in a numeric field is a zero: data are
--  punched right-justified.
proc ff_digit(c)
begin
  if c = ' ' then return 0
  if c >= '0' and c <= '9' then return c - '0'
  tt_fail("BAD CHARACTER IN A NUMERIC FIELD")
end

proc ff_read_int(w)
begin
  var n := 0, neg := false, c
  for i := 1 to w do begin
    c := ff_getch()
    if c = '-' then neg := true
    else if c <> '+' then n := n * 10 + ff_digit(c)
  end
  return neg -> -n, n
end

proc ff_read_real(w, d)
begin
  var m := 0, nd := 0, point := false, frac := 0, ex := 0, eneg := false
  var inexp := false, neg := false, c, x, skipped := 0
  for i := 1 to w do begin
    c := ff_getch()
    if inexp then begin
      if c = '-' then eneg := true
      else if c <> '+' then ex := ex * 10 + ff_digit(c)
    end else if c = '.' then point := true
    else if c = 'E' or c = 'D' then inexp := true
    else if (c = '-' or c = '+') and nd > 0 then begin
      inexp := true
      eneg := c = '-'
    end else if c = '-' then neg := true
    else if c <> '+' then begin
      if m < 100000000000 then begin
        m := m * 10 + ff_digit(c)
        if m > 0 then nd := nd + 1
        if point then frac := frac + 1
      end else begin
        ff_digit(c)
        if not point then skipped := skipped + 1
      end
    end
  end
  if eneg then ex := -ex
  if not point then frac := d
  x := tt_scale10(float(m), ex - frac + skipped)
  return neg -> tt_fneg(x), x
end

proc ff_read_log(w)
begin
  var c, v := 0, seen := false
  for i := 1 to w do begin
    c := ff_getch()
    if not seen and c <> ' ' and c <> '.' then begin
      seen := true
      if c = 'T' then v := 1
      else if c = 'F' then v := -1
      else if c = 'U' then v := 0
      else tt_fail("BAD CHARACTER IN AN L FIELD")
    end
  end
  return v
end

proc ff_read_tern(w)
begin
  var n := 0, c
  for i := 1 to w do begin
    c := ff_getch()
    n := n * 3
    if c = '1' then n := n + 1
    else if c = 'T' or c = '-' then n := n - 1
    else if c <> '0' and c <> ' ' then tt_fail("BAD CHARACTER IN A B FIELD")
  end
  return n
end

-- the start of a READ: +1, or -1 at the end of the cards when the READ
-- has END=
proc tt_rbeg(f, hasend)
begin
  ff_begin(f, 5)
  if not ff_read_card() then begin
    if hasend > 0 then return -1
    tt_fail("END OF DATA ON THE CARD READER")
  end
  return 1
end

proc tt_ri()
begin
  var p := ff_next(), c := ff[p]
  if c = F_I then return ff_read_int(ff[p + 1])
  if c = F_B then return ff_read_tern(ff[p + 1])
  ff_mismatch("AN INTEGER NEEDS AN I OR B FIELD")
end

proc tt_rr()
begin
  var p := ff_next(), c := ff[p]
  if c = F_F or c = F_E then return ff_read_real(ff[p + 1], ff[p + 2])
  ff_mismatch("A REAL NEEDS AN F OR E FIELD")
end

proc tt_rl()
begin
  var p := ff_next(), c := ff[p]
  if c = F_L then return ff_read_log(ff[p + 1])
  ff_mismatch("A LOGICAL NEEDS AN L FIELD")
end

proc tt_ra(a, n, ty)
begin
  for i := 0 to n - 1 do begin
    if ty < 0 then a[i] := tt_ri()
    else if ty = 0 then a[i] := tt_rr()
    else a[i] := tt_rl()
  end
end
