-- =====================================================================
--  TUNNY: THE LORENZ SZ42, ENCIPHERING A MESSAGE ONTO TAPE
--
--  The first half of a job in two steps (jobs/colossus.job).  This step
--  is the German side.  It takes Genesis 1 as the plain text, writes it
--  in teleprinter code, enciphers it on a simulation of the Lorenz
--  Schluesselzusatz SZ42 -- the machine Bletchley Park called Tunny --
--  and writes the intercept on tape 1.  The next step is Bletchley Park:
--  Colossus.
--
--  The machine adds a key to each 5-bit teleprinter character, impulse by
--  impulse (exclusive or):
--
--      Z = P + chi + psi'
--
--  from twelve pinwheels: five chi wheels (41, 31, 29, 26 and 23 pins)
--  that step with every character, five psi wheels (43, 47, 51, 53, 59)
--  that step together only when the motor wheels say so (61 and 37), so
--  that psi' often stands still, and two motor wheels.  This is the SZ42A
--  without its "limitations".
--
--  The wheel patterns were changed rarely; by the time of Colossus they
--  were broken by hand (Tutte, the Testery and the Newmanry) and known.
--  What had to be found for each message was where the wheels started:
--  the settings.  So this step also writes the chi patterns on tape 2,
--  as Bletchley knew them.  The settings it prints are known only to the
--  operators, and to whoever checks Colossus's answer.
--
--  The operators of this link double their spaces and the shift
--  characters around punctuation.  Real German traffic had habits of its
--  own -- stereotyped addresses, repeated characters, "5M89" -- that made
--  consecutive plain-text characters agree more often than chance; this
--  is the regularity Tutte's method feeds on.  The program measures it.
-- =====================================================================

get "devices"

const N = 4000                        -- characters in the message
const REC = 243                       -- characters to a tape record

-- the teleprinter alphabet (ITA2) in Bletchley's notation: letters, and
-- / null, 9 space, 3 line feed, 4 carriage return, 5 figure shift,
-- 8 letter shift; impulse 1 is the first (leftmost) bit
global alpha := "ABCDEFGHIJKLMNOPQRSTUVWXYZ/93458"
global codes := table(24, 19, 14, 18, 16, 22, 11, 5, 12, 26, 30, 9, 7,
                      6, 3, 13, 29, 10, 20, 1, 28, 15, 25, 23, 21, 17,
                      0, 4, 2, 8, 27, 31)

global wlen := table(41, 31, 29, 26, 23, 43, 47, 51, 53, 59, 61, 37)
global pins[600], wbase[12]

global seed

proc rnd(n)
begin
  seed := 16807 * (seed mod 127773) - 2836 * (seed / 127773)
  if seed <= 0 then seed := seed + 2147483647
  return seed mod n
end

proc code_of(ch)
begin
  for i := 1 to alpha[0] do
    if alpha[i] = ch then return codes[i - 1]
  return 0
end

proc char_of(c)
begin
  for i := 0 to 31 do
    if codes[i] = c then return alpha[i + 1]
  return '?'
end

-- bit k (1..5) of a character, impulse 1 the leftmost
proc bit(c, k) = c / table(16, 8, 4, 2, 1)[k - 1] mod 2

-- ---------------------------------------------------------------------
--  the plain text, in teleprinter code
-- ---------------------------------------------------------------------
global ptext[6000], np, line[200]

proc put(s)
begin
  for i := 1 to s[0] do begin
    if np < 6000 then ptext[np] := code_of(s[i])
    np := np + 1
  end
end

proc read_text()
begin
  var c, s[2]
  np := 0
  s[0] := 1
  while readline(line, 199) do begin
    for i := 1 to line[0] do begin
      c := line[i]
      if c >= 'a' and c <= 'z' then c := c - 'a' + 'A'
      if c >= 'A' and c <= 'Z' then begin s[1] := c; put(s) end
      else if c = ' ' then put("99")
      else if c = '.' or c = ';' or c = ':' then put("55M889")
      else if c = ',' then put("55N889")
    end
    put("3344")
  end
end

-- ---------------------------------------------------------------------
--  the machine
-- ---------------------------------------------------------------------
global pos[12], ztext[N]

proc pin(w, i) = pins[wbase[w] + i]

proc make_wheels()
begin
  var b := 0, dens
  for w := 0 to 11 do begin
    wbase[w] := b
    -- about half the pins raised on the chi and psi wheels; the motor
    -- wheels as the operators set them
    dens := w = 10 -> 70, w = 11 -> 40, 50
    for i := 0 to wlen[w] - 1 do pins[b + i] := rnd(100) < dens -> 1, 0
    b := b + wlen[w]
  end
end

proc encipher()
begin
  var p, k, z, moved := 0
  for i := 0 to N - 1 do begin
    p := ptext[i]
    z := 0
    for j := 1 to 5 do begin
      k := (pin(j - 1, pos[j - 1]) + pin(j + 4, pos[j + 4])) mod 2
      z := z * 2 + (bit(p, j) + k) mod 2
    end
    ztext[i] := z
    -- the chi wheels step every time; the psi wheels when the second
    -- motor wheel shows a raised pin; that wheel when the first does
    for j := 0 to 4 do pos[j] := (pos[j] + 1) mod wlen[j]
    if pin(11, pos[11]) = 1 then begin
      moved := moved + 1
      for j := 5 to 9 do pos[j] := (pos[j] + 1) mod wlen[j]
    end
    if pin(10, pos[10]) = 1 then pos[11] := (pos[11] + 1) mod 37
    pos[10] := (pos[10] + 1) mod 61
  end
  return moved
end

proc show(t, n)
begin
  prints("   ")
  for i := 0 to n - 1 do begin
    putc(char_of(t[i]))
    if i mod 64 = 63 and i < n - 1 then prints("\n   ")
  end
  newline()
end

global setting[12]

proc main()
begin
  var moved, agree := 0, d, buf[REC], n
  prints("TUNNY: A MESSAGE ENCIPHERED ON THE LORENZ SZ42\n\n")
  read_text()
  if np < N then begin prints("*** not enough plain text\n"); exit(8) end
  prints("   The plain text (Genesis 1) in teleprinter code, ")
  print(np); prints(" characters; the\n   message is the first ")
  print(N); prints(":\n\n")
  show(ptext, 192)
  -- how often consecutive characters agree in impulses 1 and 2
  for i := 0 to N - 2 do begin
    d := (bit(ptext[i], 1) + bit(ptext[i + 1], 1) + bit(ptext[i], 2) +
          bit(ptext[i + 1], 2)) mod 2
    if d = 0 then agree := agree + 1
  end
  prints("\n   In the plain text, delta-impulse 1 equals delta-impulse 2 at ")
  printfix(agree * 1000 / (N - 1), 1); prints("%\n   of the characters.\n\n")

  seed := 1944                        -- the wheel patterns of the month
  make_wheels()
  seed := 4471                        -- the settings of this message
  for w := 0 to 11 do begin
    setting[w] := rnd(wlen[w])
    pos[w] := setting[w]
  end
  moved := encipher()
  prints("   The cipher text, as intercepted:\n\n")
  show(ztext, 192)
  prints("\n   The psi wheels moved on ")
  printfix(moved * 1000 / N, 1)
  prints("% of the characters and stood still\n   on the rest.\n")

  -- the intercept on tape 1, the chi patterns on tape 2
  n := 0
  for i := 0 to N - 1 do begin
    buf[n] := ztext[i]; n := n + 1
    if n = REC or i = N - 1 then begin twrite(1, buf, n); n := 0 end
  end
  tmark(1)
  for w := 0 to 4 do twrite(2, pins + wbase[w], wlen[w])
  tmark(2)
  prints("\n   The intercept is on tape 1, the chi wheel patterns on tape 2.\n")
  prints("\n   The settings, known only to the operators:\n      chi ")
  for w := 0 to 4 do begin print(setting[w] + 1); spaces(1) end
  prints("  psi ")
  for w := 5 to 9 do begin print(setting[w] + 1); spaces(1) end
  prints("  motor ")
  print(setting[10] + 1); spaces(1); print(setting[11] + 1)
  newline()
  return 0
end
