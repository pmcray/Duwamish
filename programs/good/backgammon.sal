-- =====================================================================
--  BACKGAMMON: learning a game of chance by playing it against itself.
--
--  Chess and draughts are games of certainty; backgammon is a game of
--  expectation.  A program cannot know what the dice will do, only what
--  they are likely to do -- the probabilist's world, and I. J. Good's.
--  (Donald Michie's "Game-playing and game-learning automata", 1966,
--  showed how minimax extends to chance: average over the dice.)
--
--  THE BOARD is always seen from the side of the player to move: his
--  checkers positive, the opponent's negative.  Handing the board to the
--  other player is a reversal and a negation -- the same trick as the
--  ternary words themselves, where the other sign is one NEG away.
--
--  THE EVALUATION is linear, a single layer of weights over ten features
--  of a position, in the manner of Rosenblatt's perceptron: the race,
--  blots, points made in each home board, the longest prime, checkers
--  hit, checkers borne off, and anchors.
--
--  LEARNING is Samuel's, applied to a game of chance.  The program plays
--  itself.  After each move it nudges its evaluation of its previous
--  position towards its evaluation of the new one, and at the end of the
--  game towards the result: a win is +100, a loss -100.  The dice supply
--  all the exploration a learner needs.  This is temporal-difference
--  learning -- the method with which Tesauro's TD-Gammon (1992), using a
--  multi-layer network, came to play backgammon at world-class strength.
--
--  THE TEST is an evaluation written by hand, as a 1967 programmer would
--  write one from his own understanding of the game.  The learner starts
--  knowing nothing -- every move looks as good as every other.
-- =====================================================================

const NF = 10, PW = 30             -- features; words per position
const BAR = 26, OBAR = 27, OFF = 28, OOFF = 29
const RATE = 1000                  -- 0.1, in the units used by td()
const TRAIN = 30, EVERY = 15, TEST = 8
const MAXTURNS = 400

global seed := 1992
global cur[PW], nxt[PW]
global best[6 * PW], bestval[6], count[6]
global dice[4], ndice, bigdie, isdouble
global lastsrc[6], dieused[6], firstk[6]
global mode, curw                  -- how the player to move chooses
global learned[NF], hand[NF]
global feat[NF], prevf[2 * NF], haveprev[2]
global fname := table("race lead (pips)", "my blots", "their blots",
                      "my home-board points", "their home-board points",
                      "my longest prime", "checkers hit", "checkers borne off",
                      "my anchors in their home", "bias")

const RANDOM = 0, EVAL = 1

proc random31()
begin
  var hi := seed / 44488, lo := seed mod 44488
  seed := 48271 * lo - 3399 * hi
  if seed <= 0 then seed := seed + 2147483647
  return seed
end

proc random(n) = random31() mod n

proc copypos(src, dst)
begin
  for i := 0 to PW - 1 do dst[i] := src[i]
end

proc setup(s)
begin
  for i := 0 to PW - 1 do s[i] := 0
  s[24] := 2; s[13] := 5; s[8] := 3; s[6] := 5
  s[1] := -2; s[12] := -5; s[17] := -3; s[19] := -5
end

-- hand the board to the other player: reverse and negate
proc flip(s, d)
begin
  for i := 1 to 24 do d[i] := -s[25 - i]
  d[BAR] := s[OBAR]; d[OBAR] := s[BAR]
  d[OFF] := s[OOFF]; d[OOFF] := s[OFF]
end

proc allhome(s)
begin
  if s[BAR] > 0 then return false
  for i := 7 to 24 do if s[i] > 0 then return false
  return true
end

-- Move one checker from src (25 = the bar) by d, in place on wp.  The
-- changes are pushed on an undo stack so the search can take them back.
global wp[PW]
global u_src[8], u_t[8], u_hit[8], utop := 0

proc apply(src, d)
begin
  var t
  if src = 25 then begin
    if wp[BAR] = 0 then return false
    t := 25 - d
  end else begin
    if wp[src] <= 0 then return false
    t := src - d
  end
  if t <= 0 then begin                         -- bearing off
    if not allhome(wp) then return false
    if t < 0 then
      for i := src + 1 to 6 do if wp[i] > 0 then return false
    wp[src] := wp[src] - 1
    wp[OFF] := wp[OFF] + 1
    u_src[utop] := src; u_t[utop] := 0; u_hit[utop] := false
    utop := utop + 1
    return true
  end
  if wp[t] < -1 then return false              -- blocked
  if src = 25 then wp[BAR] := wp[BAR] - 1 else wp[src] := wp[src] - 1
  u_hit[utop] := wp[t] = -1
  if wp[t] = -1 then begin wp[t] := 0; wp[OBAR] := wp[OBAR] + 1 end   -- a hit
  wp[t] := wp[t] + 1
  u_src[utop] := src; u_t[utop] := t
  utop := utop + 1
  return true
end

proc undo()
begin
  var src, t
  utop := utop - 1
  src := u_src[utop]
  t := u_t[utop]
  if t = 0 then wp[OFF] := wp[OFF] - 1
  else begin
    wp[t] := wp[t] - 1
    if u_hit[utop] > 0 then begin wp[t] := -1; wp[OBAR] := wp[OBAR] - 1 end
  end
  if src = 25 then wp[BAR] := wp[BAR] + 1 else wp[src] := wp[src] + 1
end

-- ---------------------------------------------------------------------
-- the evaluation: ten features, each times ten, from the mover's side
-- ---------------------------------------------------------------------
proc features(s)
begin
  var pips := 25 * s[BAR], opips := 25 * s[OBAR], v, run := 0, prime := 0
  var myblots := 0, theirblots := 0, myhome := 0, theirhome := 0, anchors := 0
  for i := 1 to 24 do begin
    v := s[i]
    if v > 0 then begin
      pips := pips + i * v
      if v = 1 then begin myblots := myblots + 1; run := 0 end
      else begin
        run := run + 1
        if run > prime then prime := run
        if i <= 6 then myhome := myhome + 1
        if i >= 19 then anchors := anchors + 1
      end
    end else begin
      run := 0
      if v < 0 then begin
        opips := opips - (25 - i) * v
        if v = -1 then theirblots := theirblots + 1
        else if i >= 19 then theirhome := theirhome + 1
      end
    end
  end
  feat[0] := opips - pips
  feat[1] := 10 * myblots
  feat[2] := 10 * theirblots
  feat[3] := 10 * myhome
  feat[4] := 10 * theirhome
  feat[5] := 10 * prime
  feat[6] := 10 * (s[OBAR] - s[BAR])
  feat[7] := 10 * (s[OFF] - s[OOFF])
  feat[8] := 10 * anchors
  feat[9] := 10
end

proc value(s, w)
begin
  var v := 0
  features(s)
  for f := 0 to NF - 1 do v := v + w[f] * feat[f]
  return v / 10000
end

-- ---------------------------------------------------------------------
-- move generation: every legal way to play the dice, found by searching
-- the orders in which dice and checkers can be moved.  Each finished
-- position is judged at once.  The rules: play as many dice as possible;
-- if only one of two different dice can be played, play the larger.
-- ---------------------------------------------------------------------
proc consider(lv, c)
begin
  var v
  count[c] := count[c] + 1
  if mode = RANDOM then begin
    if random(count[c]) = 0 then copypos(wp, best + c * PW)
  end else begin
    v := value(wp, curw)
    if count[c] = 1 or v > bestval[c] then begin
      bestval[c] := v
      copypos(wp, best + c * PW)
    end
  end
end

proc leaf(lv)
begin
  consider(lv, lv)
  if lv = 1 and not isdouble and dieused[1] = bigdie then consider(lv, 5)
end

proc rec(lv)
begin
  var moved := false, d, lo, hi
  var kmin, kmax
  -- which dice may be played at this depth?
  if isdouble then begin
    if lv < 4 then begin kmin := 0; kmax := 0 end else begin kmin := 1; kmax := 0 end
  end else if lv = 0 then begin kmin := 0; kmax := 1 end
  else if lv = 1 then begin kmin := 1 - firstk[1]; kmax := kmin end
  else begin kmin := 1; kmax := 0 end
  for k := kmin to kmax do begin
    d := dice[k]
    hi := wp[BAR] > 0 -> 25, 24
    lo := wp[BAR] > 0 -> 25, 1
    -- with doubles, move checkers in order, highest first, so that the
    -- same play is not found in every possible order
    if isdouble and lv > 0 then hi := min(hi, lastsrc[lv])
    for src := hi to lo by -1 do
      if apply(src, d) then begin
        moved := true
        lastsrc[lv + 1] := src
        dieused[lv + 1] := d
        firstk[lv + 1] := k
        rec(lv + 1)
        undo()
      end
  end
  if not moved then leaf(lv)
end

-- the player to move plays the dice on cur, according to mode and curw
proc play_turn()
begin
  var c := -1
  for i := 0 to 5 do count[i] := 0
  copypos(cur, wp)
  utop := 0
  lastsrc[0] := 25
  rec(0)
  for u := 4 to 0 by -1 do
    if c < 0 and count[u] > 0 then c := u
  if c = 1 and not isdouble and count[5] > 0 then c := 5
  copypos(best + c * PW, cur)
end

proc roll()
begin
  dice[0] := random(6) + 1
  dice[1] := random(6) + 1
  isdouble := dice[0] = dice[1]
  bigdie := max(dice[0], dice[1])
end

-- ---------------------------------------------------------------------
-- temporal-difference learning, with Widrow and Hoff's normalisation
-- ---------------------------------------------------------------------
proc td(who, target)
begin
  var v := 0, n := 100, delta, f
  for i := 0 to NF - 1 do begin
    f := prevf[who * NF + i]
    v := v + learned[i] * f
    n := n + f * f
  end
  delta := max(-100, min(100, target - v / 10000))
  for i := 0 to NF - 1 do
    learned[i] := learned[i] + RATE * delta * prevf[who * NF + i] / n
end

proc remember(who)
begin
  for i := 0 to NF - 1 do prevf[who * NF + i] := feat[i]
  haveprev[who] := true
end

-- a game between two players; mode_a/w_a moves first.  Returns +1 if the
-- first player wins, -1 if the second.  If learn, both sides learn.
proc game(mode_a, w_a, mode_b, w_b, learn)
begin
  var who := 0, v
  setup(cur)
  haveprev[0] := false; haveprev[1] := false
  roll()
  while isdouble do roll()                     -- the opening roll is not a double
  for turn := 1 to MAXTURNS do begin
    if turn > 1 then roll()
    mode := who = 0 -> mode_a, mode_b
    curw := who = 0 -> w_a, w_b
    play_turn()
    if cur[OFF] = 15 then begin
      if learn then begin
        if haveprev[who] then td(who, 100)
        if haveprev[1 - who] then td(1 - who, -100)
      end
      return who = 0 -> 1, -1
    end
    if learn then begin
      v := value(cur, learned)                 -- also leaves feat[] set
      if haveprev[who] then td(who, v)
      features(cur)
      remember(who)
    end
    flip(cur, nxt)
    copypos(nxt, cur)
    who := 1 - who
  end
  return 0
end

-- the learner against the hand-written evaluation, alternating who starts
proc test()
begin
  var won := 0
  for g := 1 to TEST do begin
    if game(EVAL, learned, EVAL, hand, false) > 0 then won := won + 1
    if game(EVAL, hand, EVAL, learned, false) < 0 then won := won + 1
  end
  return won
end

proc bars(won)
begin
  printw(won, 6); prints(" of "); print(2 * TEST); spaces(3)
  for i := 1 to won do prints("##")
end

proc main()
begin
  -- the hand-written evaluation, in thousandths
  hand[0] := 1000; hand[1] := -1000; hand[2] := 500; hand[3] := 1000
  hand[4] := -1000; hand[5] := 1000; hand[6] := 2000; hand[7] := 1000
  hand[8] := 500; hand[9] := 0
  prints("BACKGAMMON -- learning a game of chance by self-play\n\n")
  prints(" games of    wins against the\n")
  prints(" self-play   hand-written evaluation\n")
  printw(0, 6); bars(test()); prints("   (it cannot yet tell one move from another)\n")
  for g := 1 to TRAIN do begin
    game(EVAL, learned, EVAL, learned, true)
    if g mod EVERY = 0 then begin printw(g, 6); bars(test()); newline() end
  end
  prints("\nwhat it learned, beside what its programmer wrote:\n\n")
  prints("   feature                        learned    hand-written\n")
  for f := 0 to NF - 1 do begin
    prints("   "); printsw(fname[f], 30)
    if learned[f] >= 0 then putc(' ')
    printfix(learned[f] / 10, 2); spaces(8)
    if hand[f] >= 0 then putc(' ')
    printfix(hand[f] / 10, 2); newline()
  end
  prints("\nFrom nothing, the dice and its own games taught it to play nearly as\n")
  prints("well as the evaluation its programmer wrote -- while, by the weights it\n")
  prints("chose, disagreeing with him about why.  A single layer of ten weights\n")
  prints("goes little further; TD-Gammon added a hidden layer and reached\n")
  prints("world-class strength.\n")
  return 0
end
