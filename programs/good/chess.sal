-- =====================================================================
--  CHESS: Los Alamos chess, and the arithmetic of lookahead.
--
--  Chess was the first great target of machine intelligence.  Turing
--  designed a chess machine on paper and played it by hand; Shannon's
--  "Programming a Computer for Playing Chess" (1950) set out the plan
--  every later program followed: look ahead through the tree of moves,
--  score the positions at the end with an evaluation function, and back
--  the scores up by minimax.  In 1956 the MANIAC I at Los Alamos played a
--  cut-down game on a 6x6 board without bishops -- this game -- and in
--  1966-67 a program at Stanford played a correspondence match against
--  one in Moscow.  I. J. Good wrote "A Five-Year Plan for Automatic
--  Chess" (1968).
--
--  LOS ALAMOS CHESS: a 6x6 board; rooks, knights, a queen and a king on
--  each side, and six pawns that move one square at a time; no castling,
--  no en passant; a pawn that reaches the last rank becomes a queen.
--
--  THE BOARD: white pieces positive, black negative -- the sign is the
--  colour, as throughout the Duwamish's games.
--
--  THIS PROGRAM shows two things.  First, the arithmetic: how many
--  positions a full minimax search must examine, and how many alpha-beta
--  pruning needs to reach the same answer.  Second, what lookahead is
--  worth: a game between a program that looks three moves (plies) ahead
--  and one that, like Turing's paper machine, looks one move ahead and
--  follows only the captures further.
-- =====================================================================

const W = 10, SZ = W * W, BORDER = 9
const PAWN = 1, KNIGHT = 2, ROOK = 3, QUEEN = 4, KING = 5
const MATE = 100000, INF = 1000000
const MAXMV = 6000
const MAXPLIES = 100
const STRONG = 3, WEAK = 1
const PERFT = 0                   -- if > 0, only count move trees (a test)

global b[SZ], sq[36]
global value := table(0, 100, 300, 500, 900, 0)
global letter := table(' ', 'P', 'N', 'R', 'Q', 'K')
global kdirs := table(1, -1, W, -W, W + 1, W - 1, -W + 1, -W - 1)
global ndirs := table(2 * W + 1, 2 * W - 1, -2 * W + 1, -2 * W - 1,
                      W + 2, W - 2, -W + 2, -W - 2)
global mfrom[MAXMV], mto[MAXMV], mcap[MAXMV], mprom[MAXMV], mtop := 0
global nodes := 0, pruning := true, quiet := true

inline proc kind(v) = v < 0 -> -v, v
inline proc rowof(p) = p / W - 2
inline proc colof(p) = p mod W - 2

proc setup()
begin
  var k := 0, p
  var back := table(ROOK, KNIGHT, QUEEN, KING, KNIGHT, ROOK)
  for i := 0 to SZ - 1 do b[i] := BORDER
  for r := 0 to 5 do
    for c := 0 to 5 do begin
      p := (r + 2) * W + c + 2
      sq[k] := p
      k := k + 1
      b[p] := 0
      if r = 0 then b[p] := back[c]
      if r = 1 then b[p] := PAWN
      if r = 4 then b[p] := -PAWN
      if r = 5 then b[p] := -back[c]
    end
end

-- ---------------------------------------------------------------------
-- moves
-- ---------------------------------------------------------------------
proc add(f, t, prom)
begin
  mfrom[mtop] := f
  mto[mtop] := t
  mcap[mtop] := b[t]
  mprom[mtop] := prom
  mtop := mtop + 1
end

-- push the pseudo-legal moves for col (captures only, if caponly)
proc gen(col, caponly)
begin
  var start := mtop, p, v, k, t, fwd, d, last
  fwd := col > 0 -> W, -W
  last := col > 0 -> 5, 0
  for i := 0 to 35 do begin
    p := sq[i]
    v := b[p] * col
    if v > 0 then begin
      if v = PAWN then begin
        t := p + fwd
        if b[t] = 0 and not caponly then add(p, t, rowof(t) = last)
        for s := -1 to 1 by 2 do begin
          t := p + fwd + s
          if b[t] <> BORDER and b[t] * col < 0 then add(p, t, rowof(t) = last)
        end
      end else if v = KNIGHT or v = KING then begin
        for j := 0 to 7 do begin
          t := p + (v = KNIGHT -> ndirs[j], kdirs[j])
          if b[t] <> BORDER and b[t] * col <= 0 then
            if b[t] <> 0 or not caponly then add(p, t, false)
        end
      end else begin
        -- rook: four lines; queen: all eight
        for j := 0 to (v = ROOK -> 3, 7) do begin
          d := kdirs[j]
          t := p + d
          while b[t] = 0 do begin
            if not caponly then add(p, t, false)
            t := t + d
          end
          if b[t] <> BORDER and b[t] * col < 0 then add(p, t, false)
        end
      end
    end
  end
  return mtop - start
end

proc make(i)
begin
  var v := b[mfrom[i]]
  b[mfrom[i]] := 0
  b[mto[i]] := mprom[i] > 0 -> (v > 0 -> QUEEN, -QUEEN), v
end

proc unmake(i)
begin
  var v := b[mto[i]]
  if mprom[i] > 0 then v := v > 0 -> PAWN, -PAWN
  b[mfrom[i]] := v
  b[mto[i]] := mcap[i]
end

-- is square p attacked by col?
proc attacked(p, col)
begin
  var t, d, v
  for j := 0 to 7 do begin
    if b[p + ndirs[j]] = col * KNIGHT then return true
    if b[p + kdirs[j]] = col * KING then return true
  end
  -- pawns of col attack from behind (as col sees it)
  d := col > 0 -> -W, W
  if b[p + d - 1] = col * PAWN or b[p + d + 1] = col * PAWN then return true
  for j := 0 to 7 do begin
    d := kdirs[j]
    t := p + d
    while b[t] = 0 do t := t + d
    v := b[t] * col
    if v = QUEEN or (v = ROOK and j < 4) then return true
  end
  return false
end

proc king_of(col)
begin
  for i := 0 to 35 do if b[sq[i]] = col * KING then return sq[i]
  return 0
end

proc in_check(col) = attacked(king_of(col), -col)

-- ---------------------------------------------------------------------
-- evaluation: material, pawns' progress, and knights in the centre
-- ---------------------------------------------------------------------
proc evaluate(col)
begin
  var s := 0, p, v, k, r, c
  for i := 0 to 35 do begin
    p := sq[i]
    v := b[p]
    if v <> 0 then begin
      k := kind(v)
      r := rowof(p)
      c := colof(p)
      v := value[k] * (v > 0 -> 1, -1)
      if k = PAWN then v := v + (b[p] > 0 -> 10 * r, -10 * (5 - r))
      if k = KNIGHT and r >= 1 and r <= 4 and c >= 1 and c <= 4 then
        v := v + (b[p] > 0 -> 15, -15)
      s := s + v
    end
  end
  return s * col
end

-- put the move with the most valuable capture first (partial sort)
proc order(start, n)
begin
  var bi, bv, v, t
  for j := start to start + n - 2 do begin
    bi := j
    bv := kind(mcap[j])
    for k := j + 1 to start + n - 1 do begin
      v := kind(mcap[k])
      if v > bv then begin bv := v; bi := k end
    end
    if bi <> j then begin
      t := mfrom[j]; mfrom[j] := mfrom[bi]; mfrom[bi] := t
      t := mto[j]; mto[j] := mto[bi]; mto[bi] := t
      t := mcap[j]; mcap[j] := mcap[bi]; mcap[bi] := t
      t := mprom[j]; mprom[j] := mprom[bi]; mprom[bi] := t
    end
  end
end

-- ---------------------------------------------------------------------
-- search.  Moves are pseudo-legal; a move that captures the king means
-- the previous move was illegal, and scores as a win.
-- ---------------------------------------------------------------------
proc quiesce(col, lo, hi)
begin
  var start := mtop, n, v, stand
  nodes := nodes + 1
  stand := evaluate(col)
  if stand >= hi then return stand
  if stand > lo then lo := stand
  n := gen(col, true)
  order(start, n)
  for i := start to start + n - 1 do begin
    if kind(mcap[i]) = KING then begin mtop := start; return MATE end
    make(i)
    v := -quiesce(-col, -hi, -lo)
    unmake(i)
    if v >= hi then begin mtop := start; return v end
    if v > lo then lo := v
  end
  mtop := start
  return lo
end

global bestmove
proc search(col, depth, lo, hi, root)
begin
  var start := mtop, n, v, best := -INF
  if depth <= 0 then begin
    if quiet then return quiesce(col, lo, hi)
    nodes := nodes + 1
    return evaluate(col)
  end
  nodes := nodes + 1
  n := gen(col, false)
  if pruning then order(start, n)
  for i := start to start + n - 1 do begin
    if kind(mcap[i]) = KING then begin mtop := start; return MATE end
    make(i)
    if root and in_check(col) then v := -INF      -- illegal at the root
    else v := -search(-col, depth - 1, -hi, -lo, false)
    unmake(i)
    if v > best then begin
      best := v
      if root then bestmove := i
    end
    if pruning then begin
      if v > lo then lo := v
      if lo >= hi then break
    end
  end
  mtop := start
  -- a mated side loses sooner rather than later
  if best <= -MATE + 1000 and best > -INF then best := best + 1
  return best
end

-- does col have any legal move?
proc has_legal(col)
begin
  var start := mtop, n, ok := false
  n := gen(col, false)
  for i := start to start + n - 1 do
    if not ok then begin
      make(i)
      if not in_check(col) then ok := true
      unmake(i)
    end
  mtop := start
  return ok
end

-- ---------------------------------------------------------------------
-- notation and display
-- ---------------------------------------------------------------------
proc square_name(p)
begin
  putc('a' + colof(p))
  putc('1' + rowof(p))
end

proc print_move(i)
begin
  var k := kind(b[mfrom[i]])
  if k <> PAWN then putc(letter[k])
  square_name(mfrom[i])
  putc(mcap[i] <> 0 -> 'x', '-')
  square_name(mto[i])
  if mprom[i] > 0 then prints("=Q")
end

proc show_board()
begin
  var v
  for r := 5 to 0 by -1 do begin
    prints("      "); putc('1' + r); spaces(2)
    for c := 0 to 5 do begin
      v := b[(r + 2) * W + c + 2]
      if v = 0 then putc((r + c) mod 2 = 0 -> '.', ':')
      else if v > 0 then putc(letter[v])
      else putc(letter[-v] + 32)
      space()
    end
    newline()
  end
  prints("         a b c d e f\n")
end

-- ---------------------------------------------------------------------
-- part 1: the arithmetic of lookahead
-- ---------------------------------------------------------------------
proc count_search(depth, prune)
begin
  var v
  setup()
  nodes := 0
  pruning := prune
  quiet := false
  mtop := 0
  v := search(1, depth, -INF, INF, true)
  return v
end

proc arithmetic()
begin
  var n1, n2, v1, v2
  prints("1. The arithmetic of lookahead (from the opening position)\n\n")
  prints("   plies   minimax examines   alpha-beta examines   saving   same score?\n")
  for d := 1 to 4 do begin
    v1 := count_search(d, false)
    n1 := nodes
    v2 := count_search(d, true)
    n2 := nodes
    printw(d, 7); printw(n1, 19); printw(n2, 22)
    printw(100 - 100 * n2 / n1, 8); prints("%")
    prints(v1 = v2 -> "      yes\n", "      NO\n")
  end
  prints("\n   Alpha-beta never changes the answer: it only stops looking at\n")
  prints("   moves that cannot matter.  Its saving grows with depth, and with good\n")
  prints("   move ordering it can look nearly twice as deep for the same work.\n\n")
end

-- ---------------------------------------------------------------------
-- part 2: a game
-- ---------------------------------------------------------------------
proc game()
begin
  var col := 1, depth, moveno := 1, v, result := 0, total := 0
  setup()
  pruning := true
  quiet := true
  prints("2. A game: White looks ")
  print(STRONG); prints(" plies ahead; Black looks ")
  print(WEAK); prints(",\n   following captures further.\n\n")
  for ply := 1 to MAXPLIES do begin
    if result = 0 then begin
      if not has_legal(col) then begin
        result := in_check(col) -> -col, 2
      end else begin
        depth := col > 0 -> STRONG, WEAK
        nodes := 0
        mtop := 0
        v := search(col, depth, -INF, INF, true)
        total := total + nodes
        if col > 0 then begin
          printw(moveno, 4); prints(". ")
        end else prints("   ")
        print_move(bestmove)
        spaces(9 - (mprom[bestmove] > 0 -> 2, 0) -
               (kind(b[mfrom[bestmove]]) = PAWN -> 0, 1))
        if col < 0 then begin newline(); moveno := moveno + 1 end
        make(bestmove)
        col := -col
      end
    end
  end
  newline()
  newline()
  show_board()
  newline()
  prints("   ")
  if result = 1 then prints("White (three plies) wins by checkmate.")
  else if result = -1 then prints("Black (one ply) wins by checkmate.")
  else if result = 2 then prints("Stalemate: a draw.")
  else begin
    v := evaluate(1)
    prints("Unfinished after "); print(MAXPLIES); prints(" plies; material ")
    prints(v > 0 -> "favours White.", v < 0 -> "favours Black.", "is level.")
  end
  newline()
  prints("   "); print(total); prints(" positions searched in the game.\n")
end

-- the number of legal move sequences of each length: a check on the rules
proc perft(col, d)
begin
  var start := mtop, n, total := 0
  n := gen(col, false)
  for i := start to start + n - 1 do begin
    make(i)
    if not in_check(col) then
      total := total + (d = 1 -> 1, perft(-col, d - 1))
    unmake(i)
  end
  mtop := start
  return total
end

proc main()
begin
  if PERFT > 0 then begin
    setup()
    for d := 1 to PERFT do begin prints("perft "); print(d); prints(" "); print(perft(1, d)); newline() end
    return 0
  end
  prints("CHESS -- Los Alamos chess on the Duwamish\n\n")
  arithmetic()
  game()
  prints("\nShannon's plan -- look ahead, evaluate, back up by minimax -- is\n")
  prints("all this program knows, and it is enough to beat a player that looks\n")
  prints("less far.  Whether depth alone could beat the best humans was argued\n")
  prints("for decades; in 1997 it did.\n")
  return 0
end
