-- =====================================================================
--  SORTING ON TAPE: BALANCED AND POLYPHASE MERGING
--
--  Before discs, a file too big for core was sorted on magnetic tape, and
--  the time went into moving tape, not into comparing keys.  Knuth gave
--  the subject a third of "Sorting and Searching".  This program sorts a
--  file of keys on the Duwamish's tapes three ways, each with the same
--  core, the same initial runs and four work tapes:
--
--    BALANCED          two-way merging: runs alternately onto two tapes,
--                      then merged pass after pass onto the other two,
--                      every tape rewound after every pass
--    READ BACKWARD     the same, but each pass reads the tapes the last
--                      pass wrote backward, from where the writing left
--                      them: no tape is ever rewound.  A run written
--                      ascending comes back descending, so each pass
--                      merges by the larger key and writes descending,
--                      and the next pass turns it round again.
--    POLYPHASE         Gilstad's polyphase merge (1960), as Knuth's
--                      Algorithm D (5.4.2): the runs are spread unevenly,
--                      in "generalized Fibonacci" numbers, with dummy
--                      runs to make up a perfect distribution, so that
--                      three tapes can always be merged onto the fourth.
--                      Each phase merges until one tape is empty; only
--                      that tape and the output are rewound.
--
--  The initial runs are made by replacement selection, Knuth's snowplow
--  (5.4.1), in a ternary heap: with room for P keys in core it makes
--  runs of about 2P from random data.
--
--  Tape unit 1 holds the unsorted file (made by the program); units 2 to
--  5 are the work tapes.  Records are single-word keys, written in blocks
--  of 243.  Every result is read back and checked: in order, the same
--  number of keys, the same sum.
-- =====================================================================

get "devices"

const NREC = 20000                    -- keys to sort
const P = 500                         -- room for keys in core
const B = 243                         -- words in a tape block
const MARK = -1                       -- ends a run on tape
const DONE = -2                       -- no more on the tape
const BIG = 1000000000                -- keys are below this

global seed := 1960

proc random()
begin
  seed := 16807 * (seed mod 127773) - 2836 * (seed / 127773)
  if seed <= 0 then seed := seed + 2147483647
  return seed mod BIG
end

-- ---------------------------------------------------------------------
--  blocked streams on the tapes: one block buffer for each unit
-- ---------------------------------------------------------------------
global buf[6 * B], bpos[6], blen[6], bdir[6]
global blocks_read, blocks_written, rewinds, rewind_time, tape_time

proc wopen(u)
begin
  bpos[u] := 0
end

proc wflush(u)
begin
  var t, s
  if bpos[u] > 0 then begin
    t := clock()
    s := twrite(u, buf + u * B, bpos[u])
    tape_time := tape_time + clock() - t
    if s < 0 then begin
      prints("\n*** TAPE WRITE FAILED\n"); exit(8)
    end
    blocks_written := blocks_written + 1
    bpos[u] := 0
  end
end

proc wput(u, x)
begin
  buf[u * B + bpos[u]] := x
  bpos[u] := bpos[u] + 1
  if bpos[u] = B then wflush(u)
end

-- read forward (dir +1) or backward (dir -1)
proc ropen(u, dir)
begin
  bpos[u] := 0; blen[u] := 0; bdir[u] := dir
end

proc rget(u)
begin
  var s, t
  if bpos[u] >= blen[u] then begin
    t := clock()
    s := bdir[u] > 0 -> tread(u, buf + u * B, B), treadback(u, buf + u * B, B)
    tape_time := tape_time + clock() - t
    if s <= 0 then return DONE
    blocks_read := blocks_read + 1
    blen[u] := s
    bpos[u] := 0
  end
  bpos[u] := bpos[u] + 1
  if bdir[u] > 0 then return buf[u * B + bpos[u] - 1]
  return buf[u * B + blen[u] - bpos[u]]
end

proc rew(u)
begin
  var t := clock()
  rewind(u)
  rewinds := rewinds + 1
  rewind_time := rewind_time + clock() - t
end

-- ---------------------------------------------------------------------
--  the unsorted file, on tape 1
-- ---------------------------------------------------------------------
global insum

proc make_input()
begin
  var x
  rew(1)
  wopen(1)
  insum := 0
  for i := 1 to NREC do begin
    x := random()
    insum := insum + x
    wput(1, x)
  end
  wflush(1)
  tmark(1)
end

-- ---------------------------------------------------------------------
--  replacement selection in a ternary heap of (run, key) pairs, held as
--  run * BIG + key so that one comparison orders both
-- ---------------------------------------------------------------------
global heap[P], hn, cur_run, nruns_made

proc sift(i0)
begin
  var i := i0, c, m, x := heap[i0]
  repeat
    c := 3 * i + 1
    if c >= hn then break
    m := c
    if c + 1 < hn and heap[c + 1] < heap[m] then m := c + 1
    if c + 2 < hn and heap[c + 2] < heap[m] then m := c + 2
    if heap[m] >= x then break
    heap[i] := heap[m]
    i := m
  until false
  heap[i] := x
end

proc rs_start()
begin
  var x
  rew(1)
  ropen(1, 1)
  hn := 0
  while hn < P do begin
    x := rget(1)
    if x < 0 then break
    heap[hn] := BIG + x                -- all in run 1
    hn := hn + 1
  end
  for i := (hn - 2) / 3 to 0 by -1 do sift(i)
  cur_run := 1
  nruns_made := 0
end

-- the next key of the current run; MARK when the run ends; DONE when the
-- input is all out
proc rs_next()
begin
  var top, key, x
  if hn = 0 then begin
    nruns_made := nruns_made + 1
    return DONE
  end
  top := heap[0]
  if top / BIG > cur_run then begin
    cur_run := cur_run + 1
    nruns_made := nruns_made + 1
    return MARK
  end
  key := top mod BIG
  x := rget(1)
  if x >= 0 then begin
    -- smaller than the key going out: it must wait for the next run
    heap[0] := (x >= key -> cur_run, cur_run + 1) * BIG + x
  end else begin
    hn := hn - 1
    heap[0] := heap[hn]
  end
  if hn > 0 then sift(0)
  return key
end

-- write the next run on tape u: false when the input is all out
proc write_run(u)
begin
  var x
  repeat
    x := rs_next()
    if x < 0 then break
    wput(u, x)
  until false
  wput(u, MARK)
  return x = MARK
end

-- ---------------------------------------------------------------------
--  merging one run from each of k tapes (by the smaller key, or by the
--  larger when the runs come backward)
-- ---------------------------------------------------------------------
global cur[6], live[6], keys_merged

proc merge_run(ins, k, out, larger)
begin
  var best, bi, u
  for i := 0 to k - 1 do begin
    cur[i] := rget(ins[i])
    live[i] := cur[i] >= 0
  end
  repeat
    bi := -1
    for i := 0 to k - 1 do
      if live[i] and (bi < 0 or (larger -> cur[i] > best, cur[i] < best)) then
      begin
        bi := i; best := cur[i]
      end
    if bi < 0 then break
    wput(out, best)
    keys_merged := keys_merged + 1
    u := ins[bi]
    cur[bi] := rget(u)
    live[bi] := cur[bi] >= 0
  until false
  wput(out, MARK)
end

-- ---------------------------------------------------------------------
--  checking the result, and reporting
-- ---------------------------------------------------------------------
global ok_order, ok_count, ok_sum

proc check(u, dir)
begin
  var n := 0, sum := 0, last := -1, x
  if dir > 0 then rewind(u)
  ropen(u, dir)
  ok_order := true
  if dir < 0 then begin
    x := rget(u)                       -- the run's closing mark
    if x <> MARK then ok_order := false
  end
  repeat
    x := rget(u)
    if x < 0 then break
    if x < last then ok_order := false
    last := x
    n := n + 1
    sum := sum + x
  until false
  ok_count := n = NREC
  ok_sum := sum = insum
end

global t_start, cpu_start, phases
global r_name[3], r_runs[3], r_passes[3], r_tape[3], r_rew[3], r_total[3]
global r_phases[3], r_ok[3], rewinds_of[3], r_io[3]

proc start_method()
begin
  blocks_read := 0; blocks_written := 0; rewinds := 0; rewind_time := 0
  tape_time := 0
  keys_merged := 0; phases := 0
  t_start := clock()
end

-- the time is taken before the result is checked
global t_end

proc finish_method(k, name)
begin
  r_name[k] := name
  r_runs[k] := nruns_made
  r_passes[k] := keys_merged * 100 / NREC
  r_total[k] := t_end - t_start
  rewinds_of[k] := rewinds
  r_io[k] := tape_time
  r_rew[k] := rewind_time
  r_phases[k] := phases
  r_ok[k] := ok_order and ok_count and ok_sum
end

proc secs(cycles)
begin
  printfix(cycles / 500000, 1)
end

-- ---------------------------------------------------------------------
--  1. balanced two-way merging, forward or backward
-- ---------------------------------------------------------------------
proc balanced(backward)
begin
  var ins[2], outs[2], t, more, nruns, newruns, o, dir := 1
  start_method()
  rs_start()
  for u := 2 to 5 do rew(u)
  wopen(2); wopen(3)
  t := 2
  nruns := 0
  repeat
    more := write_run(t)
    nruns := nruns + 1
    t := 5 - t
  until not more
  wflush(2); wflush(3)
  ins[0] := 2; ins[1] := 3; outs[0] := 4; outs[1] := 5
  while nruns > 1 do begin
    phases := phases + 1
    if not backward then
      for i := 0 to 1 do begin rew(ins[i]); rew(outs[i]) end
    else dir := -dir
    for i := 0 to 1 do begin
      ropen(ins[i], backward -> -1, 1)
      -- backward, a tape's first word is the mark that closed its last run
      if backward then rget(ins[i])
      wopen(outs[i])
    end
    newruns := 0
    o := 0
    for r := 1 to (nruns + 1) / 2 do begin
      merge_run(ins, 2, outs[o], backward and dir < 0)
      newruns := newruns + 1
      o := 1 - o
    end
    wflush(outs[0]); wflush(outs[1])
    for i := 0 to 1 do begin
      t := ins[i]; ins[i] := outs[i]; outs[i] := t
    end
    nruns := newruns
  end
  -- the sorted file is on ins[0]: ascending, or descending if it was
  -- last written by a backward pass, when it reads in order backward
  t_end := clock()
  check(ins[0], dir)
end

-- ---------------------------------------------------------------------
--  2. polyphase merging: Knuth's Algorithm D, with T = 4
-- ---------------------------------------------------------------------
const T = 4, PP = 3
global tp[5], A[5], D[5], R[5], L
global ptab[400], np                  -- the tapes before each phase

proc snapshot()
begin
  -- for each physical unit 2..5: real runs and dummy runs
  for u := 2 to 5 do
    for j := 1 to T do
      if tp[j] = u then begin
        ptab[np] := R[j]; ptab[np + 1] := D[j]
        np := np + 2
      end
end

proc polyphase()
begin
  var j, a, more, ins[3], k, t, x
  start_method()
  np := 0
  for i := 1 to T do tp[i] := i + 1
  -- D1
  for i := 1 to PP do begin A[i] := 1; D[i] := 1; R[i] := 0 end
  A[T] := 0; D[T] := 0; R[T] := 0
  L := 1; j := 1
  rs_start()
  for u := 2 to 5 do rew(u)
  for i := 1 to PP do wopen(tp[i])
  repeat
    -- D2: one run onto tape j
    more := write_run(tp[j])
    R[j] := R[j] + 1
    D[j] := D[j] - 1
    if not more then break
    -- D3
    if D[j] < D[j + 1] then j := j + 1
    else if D[j] = 0 then begin
      -- D4: up a level
      L := L + 1
      a := A[1]
      for i := 1 to PP do begin
        D[i] := a + A[i + 1] - A[i]
        A[i] := a + A[i + 1]
      end
      j := 1
    end else j := 1
  until false
  for i := 1 to PP do begin wflush(tp[i]); rew(tp[i]); ropen(tp[i], 1) end
  rew(tp[T])
  -- D5: merge, phase by phase
  while L > 0 do begin
    snapshot()
    phases := phases + 1
    wopen(tp[T])
    while R[PP] > 0 or D[PP] > 0 do begin
      if D[1] > 0 and D[2] > 0 and D[3] > 0 then begin
        D[T] := D[T] + 1
        for i := 1 to PP do D[i] := D[i] - 1
      end else begin
        k := 0
        for i := 1 to PP do
          if D[i] = 0 then begin
            ins[k] := tp[i]; k := k + 1
            R[i] := R[i] - 1
          end else D[i] := D[i] - 1
        merge_run(ins, k, tp[T], false)
        R[T] := R[T] + 1
      end
    end
    wflush(tp[T])
    -- D6: down a level
    L := L - 1
    rew(tp[PP]); rew(tp[T])
    t := tp[T]; x := D[T]; a := R[T]
    for i := T to 2 by -1 do begin
      tp[i] := tp[i - 1]; D[i] := D[i - 1]; R[i] := R[i - 1]
    end
    tp[1] := t; D[1] := x; R[1] := a
    ropen(tp[1], 1)
  end
  snapshot()
  t_end := clock()
  check(tp[1], 1)
end

proc show_phases()
begin
  var k := 0, row := 0, used
  spaces(11)
  for u := 2 to 5 do begin prints("  tape "); print(u); spaces(5) end
  newline()
  while k < np do begin
    if row = 0 then prints("     start ")
    else begin prints("   phase "); printw(row, 2) end
    for u := 0 to 3 do begin
      if ptab[k] + ptab[k + 1] = 0 then begin prints("      -"); used := 7 end
      else begin
        printw(ptab[k] + ptab[k + 1], 7)
        used := 7
        if ptab[k + 1] > 0 then begin
          prints(" ("); print(ptab[k + 1]); prints(")")
          used := used + 3 + digits(ptab[k + 1])
        end
      end
      spaces(13 - used)
      k := k + 2
    end
    newline()
    row := row + 1
  end
end

-- ---------------------------------------------------------------------
proc report()
begin
  prints("                   runs  phases  passes        seconds of ...")
  prints("        sorted\n")
  prints("                                       tape   rewinding  computing")
  prints("  total\n")
  for k := 0 to 2 do begin
    spaces(3); printsw(r_name[k], 15)
    printw(r_runs[k], 5)
    printw(r_phases[k], 7)
    spaces(5); printfix(r_passes[k] / 10, 1)
    spaces(6 - digits(r_io[k] / 5000000)); secs(r_io[k])
    spaces(8 - digits(r_rew[k] / 5000000)); secs(r_rew[k])
    spaces(9 - digits((r_total[k] - r_io[k] - r_rew[k]) / 5000000))
    secs(r_total[k] - r_io[k] - r_rew[k])
    spaces(5 - digits(r_total[k] / 5000000)); secs(r_total[k])
    prints(r_ok[k] -> "      yes", "      NO")
    newline()
  end
end

proc conclude()
begin
  prints("\n   Polyphase merging passes over the data ")
  printfix(r_passes[2] / 10, 1); prints(" times where balanced merging\n   passes ")
  printfix(r_passes[0] / 10, 1)
  prints(" times, and moves the tapes for "); secs(r_io[2])
  prints(" seconds rather than "); secs(r_io[0])
  prints(".\n   Reading backward leaves the tapes where the last pass left them:\n")
  prints("   rewinding takes "); secs(r_rew[1])
  prints(" seconds, setting up, instead of "); secs(r_rew[0]); prints(".\n")
  prints("   The fastest of the three here is ")
  var best := 0
  for k := 1 to 2 do if r_total[k] < r_total[best] then best := k
  prints(r_name[best]); prints(", in "); secs(r_total[best])
  prints(" seconds.\n")
  prints("   The Duwamish's channel makes the program wait while the tape\n")
  prints("   moves; with buffers in pairs and a channel that overlaps, much\n")
  prints("   of the computing could be done while the tapes run, as the tape\n")
  prints("   sorts of the period arranged.\n")
end

proc main()
begin
  prints("SORTING ON TAPE: BALANCED AND POLYPHASE MERGING\n\n")
  make_input()
  prints("   "); print(NREC)
  prints(" random keys on tape 1, in blocks of "); print(B)
  prints(" words; room for\n   "); print(P)
  prints(" keys in core; four work tapes.\n\n")

  balanced(false)
  finish_method(0, "balanced")
  prints("   Replacement selection made "); print(nruns_made)
  prints(" runs of "); print(NREC / nruns_made)
  prints(" keys on average, ")
  printfix(NREC * 100 / nruns_made / P, 2)
  prints(" times\n   the keys in core (Knuth's snowplow predicts 2).\n\n")

  balanced(true)
  finish_method(1, "read backward")

  polyphase()
  finish_method(2, "polyphase")

  prints("   The polyphase merge, phase by phase: runs on each tape before")
  prints(" the\n   phase, dummy runs in brackets.  Each phase merges three")
  prints(" tapes onto\n   the fourth until one of them is empty.\n\n")
  show_phases()
  newline()

  prints("   All three, on the same runs:\n\n")
  report()
  conclude()
  return 0
end
