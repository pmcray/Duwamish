-- =====================================================================
--  CONWAY'S LIFE, 27 CELLS TO A WORD, IN KLEENE'S LOGIC
--
--  Conway's game (Gardner, Scientific American, October 1970): a cell is
--  born with exactly three live neighbours and survives with two or
--  three.  Binary machines run it fast by keeping one cell in each bit and
--  working on whole words with AND, OR and XOR ("bit-slicing").  The
--  Duwamish can do the same with trits, and something more.
--
--  Let a live cell be +1 and a dead one -1.  Then the tritwise
--  instructions are a Boolean algebra: AND (the minimum) is "and", OR (the
--  maximum) is "or", negation is "not", and EQV (the product) is "same"
--  -- so "exclusive or" is -eqv(a, b), and the parity of three is simply
--  eqv(eqv(a, b), c).  A row of the world is one word of 27 cells, and a
--  generation is a few dozen instructions on whole rows: the eight
--  neighbours are added by full adders built from these operations.
--
--  The something more is the third value.  A trit of 0 is a cell we do
--  not know.  Kleene's logic is *sound*: whatever it calls alive or dead
--  is alive or dead in every world the unknown cells could stand for.  So
--  a partly unknown world can be run forward, and the program shows how
--  far ignorance spreads.  It then checks soundness itself, against
--  worlds in which the unknown cells are filled in at random.
-- =====================================================================

const N = 27
const ALLDEAD = -3812798742493          -- every trit -1
const TOP = 2541865828329               -- 3^26

global g[29], h[29], saved[29]
global lo_fill, hi_fill, edge_row       -- what lies beyond the world
global seed := 1970

proc random(n)
begin
  seed := (seed * 7919 + 13) mod 1000003
  return seed mod n
end

-- the world beyond the edge: dead (-1) or unknown (0)
proc beyond(v)
begin
  lo_fill := v
  hi_fill := v * TOP
  edge_row := v < 0 -> ALLDEAD, 0
  g[0] := edge_row
  g[N + 1] := edge_row
end

-- the row shifted so that each cell sees its neighbour to the west, or
-- to the east; what comes in at the edge is what lies beyond
proc west(w) = (w << 1) + lo_fill
proc east(w) = (w >> 1) + hi_fill

-- "at least two of three": the carry of a full adder
proc maj(a, b, c) = (a & b) | (c & (a | b))

-- one generation of the whole world
proc generation()
begin
  var a, b, c, n1, n2, n3, n4, n5, n6, n7, n8
  var sa, ca, sb, cb, sc, cc, s0, cd, t, u, s1, v
  for r := 1 to N do begin
    a := g[r - 1]
    b := g[r]
    c := g[r + 1]
    n1 := west(a); n2 := a; n3 := east(a)
    n4 := west(b);          n5 := east(b)
    n6 := west(c); n7 := c; n8 := east(c)
    -- add the eight neighbours: weight 1 ...
    sa := eqv(eqv(n1, n2), n3); ca := maj(n1, n2, n3)
    sb := eqv(eqv(n4, n5), n6); cb := maj(n4, n5, n6)
    sc := -eqv(n7, n8);         cc := n7 & n8
    s0 := eqv(eqv(sa, sb), sc); cd := maj(sa, sb, sc)
    -- ... weight 2, and whether there are four or more
    t := eqv(eqv(ca, cb), cc);  u := maj(ca, cb, cc)
    s1 := -eqv(t, cd);          v := t & cd
    -- two or three neighbours, and not four or more; three, or alive
    h[r] := s1 & -(u | v) & (s0 | b)
  end
  for r := 1 to N do g[r] := h[r]
end

-- ---------------------------------------------------------------------
proc clear()
begin
  for r := 1 to N do g[r] := ALLDEAD
end

proc pow3(k)
begin
  var p := 1
  for i := 1 to k do p := p * 3
  return p
end

-- set cell (r, c), counting from 1, to v: trit c-1 of row r
proc set(r, c, v)
begin
  g[r] := g[r] + (v - trit(g[r], c - 1)) * pow3(c - 1)
end

-- a picture: # alive, . dead, ? unknown
proc put(r, c, s)
begin
  var ch
  for i := 1 to s[0] do begin
    ch := s[i]
    if ch = '#' then set(r, c + i - 1, 1)
    else if ch = '?' then set(r, c + i - 1, 0)
    else set(r, c + i - 1, -1)
  end
end

global cnt_alive, cnt_dead, cnt_unknown

proc census()
begin
  var x
  cnt_alive := 0; cnt_dead := 0; cnt_unknown := 0
  for r := 1 to N do
    for c := 0 to N - 1 do begin
      x := trit(g[r], c)
      if x > 0 then cnt_alive := cnt_alive + 1
      else if x < 0 then cnt_dead := cnt_dead + 1
      else cnt_unknown := cnt_unknown + 1
    end
end

-- up to three worlds side by side
global shots[87], nshots := 0, shotgen[3], shottruth[3]

proc snapof(rows, gen, truth)
begin
  for r := 1 to N do shots[nshots * 29 + r] := rows[r]
  shotgen[nshots] := gen
  shottruth[nshots] := truth
  nshots := nshots + 1
end

proc snap(gen) = snapof(g, gen, false)

proc show()
begin
  var x
  for k := 0 to nshots - 1 do begin
    if shottruth[k] then begin
      prints("   in truth, at "); printw(shotgen[k], 2); spaces(N - 17)
    end else begin
      prints("   generation "); printw(shotgen[k], 2); spaces(N - 15)
    end
  end
  newline()
  for r := 1 to N do begin
    for k := 0 to nshots - 1 do begin
      spaces(3)
      for c := 0 to N - 1 do begin
        x := trit(shots[k * 29 + r], c)
        putc(x > 0 -> '#', x < 0 -> '.', '?')
      end
    end
    newline()
  end
  nshots := 0
end

proc header()
begin
  prints("     generation    alive     dead    unknown\n")
end

proc header2()
begin
  prints("                        Kleene's logic says          in truth\n")
  prints("     generation    alive     dead    unknown         unknown\n")
end

proc report(gen)
begin
  census()
  printw(gen, 15); printw(cnt_alive, 9); printw(cnt_dead, 9)
  printw(cnt_unknown, 11); newline()
end

-- ---------------------------------------------------------------------
--  soundness, checked: fill the unknown cells in every possible way and
--  run the ordinary game; every cell Kleene's logic called alive or dead
--  must come out so in every one of those worlds.
-- ---------------------------------------------------------------------
global start[29], kleene[29], agree[29]
global bad, undecided_but_fixed

-- tritwise: a where a and b agree, else 0 (the median of min, max and 0)
proc same(a, b) = (a & b) | ((a | b) & 0)

global ur[12], uc[12], nunk, nworlds

proc check(gens)
begin
  var x, m
  for r := 1 to N do kleene[r] := g[r]
  nunk := 0
  for r := 1 to N do
    for c := 0 to N - 1 do
      if trit(start[r], c) = 0 then begin
        ur[nunk] := r; uc[nunk] := c; nunk := nunk + 1
      end
  nworlds := pow3(0)
  for i := 1 to nunk do nworlds := nworlds * 2
  bad := 0
  for w := 0 to nworlds - 1 do begin
    for r := 1 to N do g[r] := start[r]
    m := w
    for i := 0 to nunk - 1 do begin
      g[ur[i]] := g[ur[i]] + (m mod 2 = 1 -> 1, -1) * pow3(uc[i])
      m := m / 2
    end
    for i := 1 to gens do generation()
    for r := 1 to N do begin
      for c := 0 to N - 1 do begin
        x := trit(kleene[r], c)
        if x <> 0 and x <> trit(g[r], c) then bad := bad + 1
      end
      agree[r] := w = 0 -> g[r], same(agree[r], g[r])
    end
  end
  undecided_but_fixed := 0
  for r := 1 to N do
    for c := 0 to N - 1 do
      if trit(kleene[r], c) = 0 and trit(agree[r], c) <> 0 then
        undecided_but_fixed := undecided_but_fixed + 1
  for r := 1 to N do g[r] := kleene[r]
end

-- ---------------------------------------------------------------------
proc glider(r, c)
begin
  put(r, c, ".#.")
  put(r + 1, c, "..#")
  put(r + 2, c, "###")
end

proc classical()
begin
  var c0, cyc
  prints("1. THE ORDINARY GAME: a glider, a blinker, a block and a beehive\n\n")
  beyond(-1)
  clear()
  glider(2, 2)
  put(4, 18, "###")
  put(16, 5, "##"); put(17, 5, "##")
  put(20, 16, ".##."); put(21, 16, "#..#"); put(22, 16, ".##.")
  snap(0)
  c0 := clock()
  for i := 1 to 4 do generation()
  cyc := clock() - c0
  snap(4)
  for i := 1 to 4 do generation()
  snap(8)
  show()
  prints("\n   one generation of 729 cells: ")
  print(cyc / 4)
  prints(" cycles, ")
  printfix(cyc * 10 / 4 / 729, 1)
  prints(" a cell\n\n")
end

global kalive, kdead, kunknown

proc partial()
begin
  var gens := table(1, 2, 3, 4, 8, 12, 16)
  prints("2. A WORLD PARTLY UNSEEN: ? is a cell whose state we do not know\n\n")
  beyond(-1)
  clear()
  -- a blinker beside a cell we cannot see
  put(4, 4, "###?")
  -- a glider flying towards an unseen cell
  glider(2, 14)
  put(10, 22, "?")
  -- a block, two cells from an unseen one
  put(18, 4, "##"); put(19, 4, "##"); put(19, 8, "?")
  -- a lone unseen cell in empty space
  put(22, 18, "?")
  for r := 1 to N do start[r] := g[r]
  snap(0)
  header2()
  report(0)
  var gen := 0, allbad := 0
  for i := 0 to 6 do begin
    while gen < gens[i] do begin generation(); gen := gen + 1 end
    census()
    kalive := cnt_alive; kdead := cnt_dead; kunknown := cnt_unknown
    -- run every world the ? cells could stand for, to this generation
    check(gen)
    allbad := allbad + bad
    printw(gen, 15); printw(kalive, 9); printw(kdead, 9)
    printw(kunknown, 11); printw(kunknown - undecided_but_fixed, 16)
    newline()
    if gen = 8 then begin snap(8); snapof(agree, 8, true) end
  end
  newline()
  show()
  prints("\n   Checked against all ")
  print(nworlds)
  prints(" worlds the ? cells could stand for, at every\n   generation above: ")
  if allbad = 0 then prints("every cell Kleene's logic called alive or dead was so,\n   in every one of them.")
  else begin print(allbad); prints(" cells were called wrongly!") end
  newline()
  prints("   So the logic is sound -- but far from complete.  It cannot see, for\n")
  prints("   instance, that x or not-x is true when x is unknown, and ignorance\n")
  prints("   spreads through such blind spots faster than the facts require.\n\n")
end

proc outside()
begin
  prints("3. THE WORLD BEYOND THE EDGE UNKNOWN\n\n")
  beyond(0)
  clear()
  put(12, 12, "###")
  glider(4, 4)
  put(20, 18, "##"); put(21, 18, "##")
  snap(0)
  header()
  report(0)
  for gen := 1 to 14 do begin
    generation()
    if gen = 5 or gen = 10 then snap(gen)
    if gen mod 2 = 0 then report(gen)
  end
  newline()
  show()
  prints("\n   Ignorance of what lies beyond comes in one cell a generation:\n")
  prints("   the speed of light, in Conway's phrase.  (No cell can be\n")
  prints("   affected faster.)\n")
end

proc main()
begin
  prints("CONWAY'S LIFE IN KLEENE'S LOGIC: 27 CELLS TO A WORD\n")
  prints("# alive (+1), . dead (-1), ? unknown (0)\n\n")
  classical()
  partial()
  outside()
  return 0
end
