-- =====================================================================
--  ASHBY'S HOMEOSTAT: ULTRASTABILITY ON THE DUWAMISH
--
--  W. Ross Ashby's homeostat (1948; "Design for a Brain", 1952, 1960)
--  was four units, each a magnet on a pivot swinging in water, driven by
--  currents from all four.  Each unit's needle is an "essential
--  variable" that must stay within bounds.  When it does not, a relay
--  steps that unit's uniselector -- a stepping switch that changes the
--  strengths and signs of the connections into the unit, at random.  The
--  machine does not know which settings are stable.  It only knows when
--  a needle is out of bounds, and changes something when it is.  That
--  is enough: it goes on changing until it finds a setting under which
--  all four needles stay in bounds.  Ashby called this ultrastability.
--
--  On the Duwamish:
--
--    the needles     x' = A x, integrated in steps of 1/27; A has -1 on
--                    the diagonal (each magnet's damping) and the
--                    connections, 2 times -1, 0 or +1, off it
--    a uniselector   27 positions: each position is a 3-trit word giving
--                    the signs of the unit's three input connections
--                    (Ashby's had 25, wired from a table of random
--                    numbers; this one's order is random too)
--    the relay       each unit's critical state is a trit: +1 above its
--                    bound, -1 below, 0 within; not 0 steps the switch
--
--  The program, not the homeostat, checks which settings are stable, by
--  the Routh-Hurwitz test on A's characteristic polynomial.
-- =====================================================================

const S = 6561                        -- 1.0 in fixed point (3^8)
const THETA = 6561                    -- the bound on each needle: 1.0
const STOP = 13122                    -- the needle's end stop: 2.0
const G = 2                           -- the strength of a connection
const DWELL = 27                      -- steps between moves of one switch

global x[4], a[16], pos[4], uni[108], hand[16]
global dwell[4], steps[4], moved[4], pend[4]
global seed := 1948
global t := 0, rested

proc random(n)
begin
  seed := (seed * 7919 + 13) mod 1000003
  return seed mod n
end

-- the connection into unit i from unit j
proc w(i, j) = a[4 * i + j]

-- set unit i's inputs from its uniselector: the three trits of the word
-- at the switch's position, one for each other unit, times the hand
-- switches the experimenter may throw
proc wire(i)
begin
  var word := uni[27 * i + pos[i]], k := 0
  for j := 0 to 3 do
    if j = i then a[4 * i + j] := -1
    else begin
      a[4 * i + j] := G * trit(word, k) * hand[4 * i + j]
      k := k + 1
    end
end

proc build()
begin
  for i := 0 to 3 do begin
    -- a random order of the 27 words of three trits
    for p := 0 to 26 do uni[27 * i + p] := p - 13
    for p := 26 to 1 by -1 do begin
      var q := random(p + 1), tmp := uni[27 * i + p]
      uni[27 * i + p] := uni[27 * i + q]
      uni[27 * i + q] := tmp
    end
    pos[i] := random(27)
    for j := 0 to 3 do hand[4 * i + j] := 1
  end
  for i := 0 to 3 do wire(i)
end

-- ---------------------------------------------------------------------
--  the Routh-Hurwitz test: is every root of det(sI - A) in the left
--  half-plane?  For s^4 + c1 s^3 + c2 s^2 + c3 s + c4 it is when all the
--  c are positive, c1 c2 > c3, and c1 c2 c3 > c3^2 + c1^2 c4.
-- ---------------------------------------------------------------------
proc det2(i, j) = w(i, i) * w(j, j) - w(i, j) * w(j, i)
proc det3(i, j, k) =
  w(i, i) * (w(j, j) * w(k, k) - w(j, k) * w(k, j)) -
  w(i, j) * (w(j, i) * w(k, k) - w(j, k) * w(k, i)) +
  w(i, k) * (w(j, i) * w(k, j) - w(j, j) * w(k, i))
proc det4()
begin
  var d := 0, sgn := 1, cols[3], m
  -- expand along row 0
  for c := 0 to 3 do begin
    -- the 3x3 minor without row 0 and column c
    m := 0
    for k := 0 to 3 do if k <> c then begin cols[m] := k; m := m + 1 end
    d := d + sgn * w(0, c) * minor3(cols[0], cols[1], cols[2])
    sgn := -sgn
  end
  return d
end
proc minor3(c0, c1, c2) =
  w(1, c0) * (w(2, c1) * w(3, c2) - w(2, c2) * w(3, c1)) -
  w(1, c1) * (w(2, c0) * w(3, c2) - w(2, c2) * w(3, c0)) +
  w(1, c2) * (w(2, c0) * w(3, c1) - w(2, c1) * w(3, c0))

proc stable()
begin
  var c1, c2, c3, c4
  c1 := -(w(0, 0) + w(1, 1) + w(2, 2) + w(3, 3))
  c2 := det2(0, 1) + det2(0, 2) + det2(0, 3) + det2(1, 2) + det2(1, 3) +
        det2(2, 3)
  c3 := -(det3(0, 1, 2) + det3(0, 1, 3) + det3(0, 2, 3) + det3(1, 2, 3))
  c4 := det4()
  return c1 > 0 and c2 > 0 and c3 > 0 and c4 > 0 and c1 * c2 > c3 and
         c1 * c2 * c3 > c3 * c3 + c1 * c1 * c4
end

-- ---------------------------------------------------------------------
--  the machine
-- ---------------------------------------------------------------------
proc critical(i) = x[i] > THETA -> 1, x[i] < -THETA -> -1, 0

-- one step of 1/27 of a time unit; returns true if a switch moved
proc step()
begin
  var dx[4], s, any := false
  for i := 0 to 3 do begin
    s := 0
    for j := 0 to 3 do s := s + w(i, j) * x[j]
    dx[i] := s >> 3                              -- times 1/27
  end
  for i := 0 to 3 do begin
    x[i] := x[i] + dx[i]
    if x[i] > STOP then x[i] := STOP
    if x[i] < -STOP then x[i] := -STOP
    moved[i] := false
    if dwell[i] > 0 then dwell[i] := dwell[i] - 1
    -- the relay: the critical state is a trit, and J3 reads it
    sign critical(i) of
      - : if dwell[i] = 0 then begin
            pos[i] := (pos[i] + 1) mod 27; wire(i); moved[i] := true
          end
      + : if dwell[i] = 0 then begin
            pos[i] := (pos[i] + 1) mod 27; wire(i); moved[i] := true
          end
    end
    if moved[i] then begin
      dwell[i] := DWELL
      steps[i] := steps[i] + 1
      any := true
    end
  end
  t := t + 1
  return any
end

-- ---------------------------------------------------------------------
--  the strip chart: four needles, time running down the page
-- ---------------------------------------------------------------------
const HALF = 8                        -- a needle's column: 17 characters

proc needle(v, m)
begin
  var p := (v * HALF + STOP / 2) / STOP, b := (THETA * HALF + STOP / 2) / STOP
  if v < 0 then p := -((-v * HALF + STOP / 2) / STOP)
  for c := -HALF to HALF do
    putc(c = p -> '*', c = b or c = -b -> ':', c = 0 -> '|',
         c = -HALF -> '[', c = HALF -> ']', ' ')
  putc(m -> '<', ' ')
  spaces(2)
end

proc chartline()
begin
  printw(t / 27, 5); prints("  ")
  for i := 0 to 3 do begin needle(x[i], pend[i]); pend[i] := false end
  newline()
end

proc chart_head()
begin
  prints("   time     unit 1               unit 2               ")
  prints("unit 3               unit 4\n")
end

-- run until no switch has moved for `quiet' time units, or `limit' units
-- have passed, drawing a line every third of a unit; returns the moves
proc run(quiet, limit, draw)
begin
  var last := t, total := 0
  var until_t := t + 27 * limit
  for i := 0 to 3 do pend[i] := false
  if draw then chartline()
  while t < until_t and t - last < 27 * quiet do begin
    if step() then begin
      last := t
      for i := 0 to 3 do if moved[i] then begin
        total := total + 1
        pend[i] := true
      end
    end
    if draw and t mod 9 = 0 then chartline()
  end
  rested := t - last >= 27 * quiet
  return total
end

proc show_setting()
begin
  prints("     the uniselectors stand at")
  for i := 0 to 3 do begin prints("  "); printtw(uni[27 * i + pos[i]], 3) end
  prints(";  the field is ")
  prints(stable() -> "stable\n", "unstable\n")
end

-- ---------------------------------------------------------------------
global part := 0                      -- which part is running (for duwamish/homeoview.py)

proc part1()
begin
  var moves
  part := 1
  prints("1. SWITCHED ON: the needles are pushed off centre, and the\n")
  prints("   uniselectors start wherever they happen to be.\n")
  show_setting()
  newline()
  x[0] := S / 2; x[1] := -S / 3; x[2] := S / 4; x[3] := -S / 5
  chart_head()
  moves := run(4, 60, true)
  newline()
  prints("   The uniselectors moved "); print(moves)
  prints(" times, then stood still.\n")
  show_setting()
end

proc part2()
begin
  var moves
  part := 2
  prints("\n2. A DISTURBANCE: the experimenter pushes needle 1 aside.  The field\n")
  prints("   is stable, so the needles come back without any switch moving.\n\n")
  x[0] := S * 9 / 10
  chart_head()
  moves := run(2, 6, true)
  prints("   The uniselectors moved "); print(moves); prints(" times.\n")
end

global reversed_i := -1, reversed_j := -1

proc part3()
begin
  var moves, ri, rj, found
  part := 3
  prints("\n3. A CHANGE IN THE ENVIRONMENT: the experimenter reverses a\n")
  prints("   connection with a hand switch, as Ashby did, choosing one that\n")
  prints("   makes the present field unstable.\n")
  found := false
  for i := 0 to 3 do
    for j := 0 to 3 do
      if not found and i <> j and w(i, j) <> 0 then begin
        hand[4 * i + j] := -1
        wire(i)
        if stable() then begin hand[4 * i + j] := 1; wire(i) end
        else begin found := true; ri := i; rj := j end
      end
  if not found then prints("   (no single reversal upsets this field)\n")
  else begin
    reversed_i := ri; reversed_j := rj
    prints("   Reversed: the connection from unit "); print(rj + 1)
    prints(" into unit "); print(ri + 1); prints(".\n")
    show_setting()
    x[0] := S / 10
    newline()
    chart_head()
    moves := run(4, 60, true)
    newline()
    prints("   The uniselectors moved "); print(moves)
    prints(" times, and found a new way to keep\n   every needle in bounds.\n")
    show_setting()
  end
end

proc part4()
begin
  var n, total, nst, nrest := 0
  part := 4
  prints("\n4. HOW OFTEN IS A FIELD STABLE, AND HOW LONG DOES THE HUNT TAKE?\n")
  n := 0
  for k := 1 to 729 do begin
    for i := 0 to 3 do pos[i] := random(27)
    for i := 0 to 15 do hand[i] := 1
    for i := 0 to 3 do wire(i)
    if stable() then n := n + 1
  end
  prints("   Of 729 random settings, "); print(n)
  prints(" are stable: about 1 in "); printfix(7290 / n, 1); prints(".\n")
  total := 0; nst := 0
  for k := 1 to 20 do begin
    for i := 0 to 3 do begin
      pos[i] := random(27); x[i] := random(S) - S / 2; dwell[i] := 0
    end
    for i := 0 to 3 do wire(i)
    total := total + run(4, 100, false)
    if rested then nrest := nrest + 1
    if rested and stable() then nst := nst + 1
  end
  prints("   Switched on 20 times from random settings, the homeostat came to\n")
  prints("   rest "); print(nrest); prints(" times, ")
  print(nst); prints(" of them in a stable field, after ")
  printfix(total * 10 / 20, 1)
  prints(" moves of a\n   uniselector on average.")
  if nrest > nst then
    prints("  Where it rested in an unstable field, no needle\n   had yet left its bounds: the homeostat can find out only by the\n   needles, and an unstable field that has not thrown one out looks\n   stable to it.")
  if nrest < 20 then
    prints("  (The others were still hunting after 100 time\n   units.)")
  prints("\n   ")
  prints("Only the units whose needles go out of bounds move\n")
  prints("   their switches, so the hunt keeps whatever is already working.\n")
end

proc main()
begin
  prints("ASHBY'S HOMEOSTAT, ON THE DUWAMISH\n")
  prints("four units; * is a needle, : its bounds, < a uniselector moving\n\n")
  build()
  part1()
  part2()
  part3()
  part4()
  return 0
end
