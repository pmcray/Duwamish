C ======================================================================
C     A TOUR OF TRI-TRAN, THE DUWAMISH FORTRAN
C
C     1. KLEENE'S THREE-VALUED LOGIC, WHICH IS WHAT LOGICAL MEANS HERE
C     2. THE ARITHMETIC IF, WHICH IS ONE J3 INSTRUCTION
C     3. BALANCED TERNARY ON THE PRINTER (THE B FIELD)
C     4. A TABLE OF FUNCTIONS, AS EVERY FORTRAN PROGRAM ONCE PRINTED
C     5. DATA FROM CARDS
C
C     TEXT IN A FORMAT MAY BE HOLLERITH (NH FOLLOWED BY N CHARACTERS,
C     COUNTED BY HAND) OR, AS IBM'S FORTRAN IV ALLOWED, IN APOSTROPHES.
C ======================================================================
      LOGICAL V(3), P, Q
      INTEGER COUNT(3)
      DIMENSION X(50)
      DATA V /.FALSE., .UNKNOWN., .TRUE./
C     A STATEMENT FUNCTION
      GAUSS(T) = EXP(-T*T/2.0) / SQRT(8.0*ATAN(1.0))
C
C     1. THE TRUTH TABLES OF .AND., .OR. AND .EQV.
      PRINT 900
  900 FORMAT ('1 1. KLEENE''S THREE-VALUED LOGIC' //
     1        '     .AND. F U T     .OR. F U T     .EQV. F U T')
      DO 10 I = 1, 3
        P = V(I)
        PRINT 901, P, (P .AND. V(J), J = 1, 3),
     1             P, (P .OR. V(J), J = 1, 3),
     2             P, (P .EQV. V(J), J = 1, 3)
   10 CONTINUE
  901 FORMAT (3(L8, 2X, 3L2, 3X))
      PRINT 902
  902 FORMAT ('0    A LOGICAL IF OBEYS ITS STATEMENT ONLY WHEN THE ',
     1        'CONDITION IS .TRUE. -- NOT WHEN IT IS U.')
      Q = V(2)
      IF (Q) PRINT 903
      IF (.NOT. Q) PRINT 903
      IF (Q .OR. .NOT. Q) PRINT 903
      IF (Q .OR. .TRUE.) PRINT 904
  903 FORMAT ('     THIS IS NEVER PRINTED')
  904 FORMAT ('     Q .OR. .TRUE. IS .TRUE., WHATEVER Q IS')
C
C     2. THE ARITHMETIC IF: COUNT THE SIGNS OF THE DATA ON CARDS
      N = 0
   20 READ (5, 905, END=30) Y
  905 FORMAT (F10.3)
      N = N + 1
      X(N) = Y
      GO TO 20
   30 DO 40 I = 1, N
        IF (X(I)) 31, 32, 33
   31   COUNT(1) = COUNT(1) + 1
        GO TO 40
   32   COUNT(2) = COUNT(2) + 1
        GO TO 40
   33   COUNT(3) = COUNT(3) + 1
   40 CONTINUE
      PRINT 906, N, COUNT
  906 FORMAT ('0 2.', I3, ' NUMBERS FROM CARDS, SORTED BY ONE J3 ',
     1        'INSTRUCTION EACH INTO' /
     2        5X, I3, ' NEGATIVE,', I3, ' ZERO,', I3, ' POSITIVE')
C
C     3. BALANCED TERNARY: NO SIGN, AND ROUNDING IS TRUNCATION
      PRINT 907
  907 FORMAT ('0 3.  BALANCED TERNARY NEEDS NO SIGN' //
     1        '      N    IN BALANCED TERNARY       -N    ',
     2        'IN BALANCED TERNARY')
      DO 50 I = 1, 5
        N = 3**(I + 1) - 7*I
        PRINT 908, N, N, -N, -N
   50 CONTINUE
  908 FORMAT (1X, I7, B20, I9, B20)
C
C     4. A TABLE OF FUNCTIONS
      PRINT 909
  909 FORMAT ('0 4.  A TABLE OF FUNCTIONS' //
     1  '      X       SQRT(X)        EXP(X)        SIN(X)      ',
     2  'ATAN(X)     NORMAL DENSITY')
      DO 60 I = 1, 7
        Z = FLOAT(I - 1) * 0.5
        PRINT 910, Z, SQRT(Z), EXP(Z), SIN(Z), ATAN(Z), GAUSS(Z)
   60 CONTINUE
  910 FORMAT (1X, F7.2, 3F14.8, F13.8, E22.8)
      END
